---
import { links } from "../data/landing";
import { localeFromPath, t, type Locale } from "../i18n";

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const copy = t(locale);
---

<section class="fq section" id="faq" data-faq>
  <div class="wrap fq-layout">
    <h2 class="h-display fq-h2" data-reveal>{copy.faq.h2}</h2>
    <p class="fq-intro" data-reveal>
      {copy.faq.intro}
      {" "}
      {copy.faq.help}
      {" "}
      <a href={`mailto:${links.email}`}>{copy.faq.support}</a>
      {locale === "en" ? " for assistance." : "."}
    </p>

    <nav class="fq-side" aria-label={copy.faq.h2} data-faq-nav>
      {
        copy.faq.groups.map((group, index) => (
          <a
            class:list={["fq-cat", index === 0 && "is-on"]}
            href={`#faq-${group.id}`}
            data-faq-cat={group.id}
          >
            {group.label}
          </a>
        ))
      }
    </nav>

    <div class="fq-main">
      {
        copy.faq.groups.map((group, groupIndex) => (
          <div class="fq-group" id={`faq-${group.id}`} data-faq-group={group.id}>
            <h3 class="fq-group-h">{group.label}</h3>
            <div class="fq-list">
              {group.items.map((item, itemIndex) => (
                <details class="fq-item" open={groupIndex === 0 && itemIndex === 0}>
                  <summary>{item.q}</summary>
                  <p>{item.a}</p>
                </details>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-faq]").forEach((root) => {
    const links = [...root.querySelectorAll<HTMLAnchorElement>("[data-faq-cat]")];
    const groups = [...root.querySelectorAll<HTMLElement>("[data-faq-group]")];
    if (!links.length || !groups.length) return;

    const setActive = (id: string) => {
      links.forEach((link) => {
        const on = link.dataset.faqCat === id;
        link.classList.toggle("is-on", on);
        if (on) link.setAttribute("aria-current", "true");
        else link.removeAttribute("aria-current");
      });
    };

    links.forEach((link) => {
      link.addEventListener("click", () => {
        const id = link.dataset.faqCat;
        if (id) setActive(id);
      });
    });

    if (!("IntersectionObserver" in window)) return;

    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        const id = visible?.target instanceof HTMLElement ? visible.target.dataset.faqGroup : undefined;
        if (id) setActive(id);
      },
      { rootMargin: "-28% 0px -55% 0px", threshold: [0.2, 0.5, 0.8] },
    );
    groups.forEach((group) => io.observe(group));
  });
</script>

<style>
  .fq {
    background: var(--color-bg);
  }
  .fq-layout {
    display: grid;
    grid-template-columns: minmax(10.5rem, 0.36fr) minmax(0, 1fr);
    column-gap: clamp(2rem, 7vw, 5.5rem);
    row-gap: 2.4rem;
    align-items: start;
  }
  .fq-h2 {
    grid-column: 1;
    grid-row: 1;
    margin: 0;
    font-size: clamp(2.6rem, 6vw, 4.25rem);
    letter-spacing: -0.055em;
    line-height: 0.95;
  }
  .fq-intro {
    grid-column: 2;
    grid-row: 1;
    margin: 0.15rem 0 0;
    max-width: 28rem;
    justify-self: end;
    color: var(--color-text-secondary);
    font-size: 0.98rem;
    line-height: 1.55;
  }
  .fq-intro a {
    color: var(--color-text);
    font-weight: 600;
  }
  .fq-intro a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .fq-side {
    grid-column: 1;
    grid-row: 2;
    position: sticky;
    top: 6rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.95rem;
    padding-top: 0.2rem;
  }
  .fq-cat {
    color: var(--color-text-secondary);
    font-size: 0.94rem;
    font-weight: 500;
    line-height: 1.2;
    transition: color 0.18s ease;
  }
  .fq-cat:hover {
    color: #d4d4d8;
  }
  .fq-cat.is-on {
    color: #fafafa;
    font-weight: 600;
  }
  .fq-main {
    grid-column: 2;
    grid-row: 2;
    min-width: 0;
  }
  .fq-group {
    scroll-margin-top: 6.2rem;
  }
  .fq-group + .fq-group {
    margin-top: 2.4rem;
  }
  .fq-group-h {
    margin: 0 0 0.65rem;
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .fq-list {
    display: flex;
    flex-direction: column;
  }
  .fq-item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .fq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    cursor: pointer;
    list-style: none;
    padding: 1.05rem 0.15rem;
    font-size: 0.98rem;
    font-weight: 500;
    line-height: 1.4;
    color: #fafafa;
  }
  .fq-item summary::-webkit-details-marker {
    display: none;
  }
  .fq-item summary::after {
    content: "";
    flex: none;
    width: 0.42rem;
    height: 0.42rem;
    margin-top: -0.12rem;
    border-right: 1.5px solid #a1a1aa;
    border-bottom: 1.5px solid #a1a1aa;
    transform: rotate(45deg);
    transition: transform 0.18s ease;
  }
  .fq-item p {
    margin: 0;
    padding: 0 0.15rem 1.05rem;
    color: var(--color-text-secondary);
    font-size: 0.92rem;
    line-height: 1.55;
    max-width: 46rem;
  }
  .fq-item[open] {
    border-bottom: 0;
    margin: 0.45rem 0 0.55rem;
    padding: 0.15rem 0 0.1rem;
    background: #232326;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 16px;
  }
  .fq-item[open] summary {
    padding: 1.05rem 1.2rem 0.4rem;
  }
  .fq-item[open] summary::after {
    margin-top: 0.18rem;
    border-color: #fafafa;
    transform: rotate(-135deg);
  }
  .fq-item[open] p {
    padding: 0 1.2rem 1.15rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .fq-item summary::after {
      transition: none;
    }
  }
  @media (max-width: 860px) {
    .fq-layout {
      grid-template-columns: 1fr;
      row-gap: 1.15rem;
    }
    .fq-h2,
    .fq-intro,
    .fq-side,
    .fq-main {
      grid-column: 1;
      grid-row: auto;
    }
    .fq-intro {
      justify-self: start;
      max-width: 36rem;
    }
    .fq-side {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.7rem 1.15rem;
      top: auto;
      padding-top: 0.4rem;
    }
  }
</style>
