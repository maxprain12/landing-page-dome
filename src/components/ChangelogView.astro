---
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import ReleaseStatus from './ReleaseStatus.astro';
import { changelogUrl } from '../data/landing';
import { localizePath, t, type Locale } from '../i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const page = t(locale).pages.changelog;
---
<Nav locale={locale} esHref={changelogUrl('es')} enHref={changelogUrl('en')} />
<main id="main-content" class="cl" data-live-releases aria-busy="true">
  <div class="wrap cl-hero"><p class="eyebrow">{page.eyebrow}</p><h1 class="h-display cl-h1">{page.h1}</h1><p class="cl-lead">{page.lead}</p><p class="cl-rss"><a href={localizePath('/changelog.xml', locale)}>{page.rssLabel}</a></p></div>
  <ReleaseStatus locale={locale} kind="changelog" />
  <div class="wrap cl-list" data-live-changelog data-label-latest={page.channelLatest} data-label-beta={page.channelBeta} data-release-ready hidden></div>
  <p class="wrap cl-empty" data-changelog-empty hidden>{page.empty}</p>
</main>
<Footer locale={locale} />
<script>
  import { startLiveReleases } from '../scripts/live-releases';
  void startLiveReleases();
</script>
<style>
  [hidden] { display: none !important; }
  .cl {
    padding: clamp(2.6rem, 6vw, 4.8rem) 0 4.4rem;
  }
  .cl-hero {
    max-width: 44rem;
    margin-bottom: 2.4rem;
  }
  .cl-h1 {
    font-size: clamp(2.2rem, 5vw, 3.3rem);
    margin: 0.6rem 0 1rem;
  }
  .cl-lead {
    font-size: 1.12rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 0 0.9rem;
  }
  .cl-rss {
    margin: 0;
    font-size: 0.9rem;
  }
  .cl-rss a {
    color: var(--color-lavender-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cl-list {
    max-width: 44rem;
    display: grid;
    gap: 1.4rem;
  }
  /* The live script rebuilds these nodes without Astro's scope attribute. */
  .cl-list :global(.cl-item) {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: 1rem 1.5rem;
    padding: 1.4rem 0;
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 5.5rem;
  }
  .cl-list :global(.cl-date) {
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }
  .cl-list :global(.cl-head h2 img) {
    width: 2rem;
    height: 2rem;
  }
  .cl-list :global(.cl-head) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }
  .cl-list :global(.cl-head h2) {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }
  @media (max-width: 720px) {
    .cl-list :global(.cl-item) {
      grid-template-columns: 1fr;
    }
  }
  .cl-list :global(.cl-badges) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.75rem 0 0;
  }
  .cl-list :global(.cl-badge) {
    display: inline-flex;
    align-items: center;
    height: 1.55rem;
    padding: 0 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }
  .cl-list :global(.cl-badge.is-beta) {
    border-color: color-mix(in srgb, var(--c-olive) 40%, var(--color-border));
    color: var(--c-olive);
  }
  .cl-list :global(.cl-notes) {
    margin-top: 1rem;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
  }
  .cl-list :global(.cl-notes h2),
  .cl-list :global(.cl-notes h3),
  .cl-list :global(.cl-notes h4) {
    color: var(--color-text);
    margin: 1.1rem 0 0.45rem;
  }
  .cl-list :global(.cl-notes p) {
    margin: 0 0 0.75rem;
  }
  .cl-list :global(.cl-notes ul),
  .cl-list :global(.cl-notes ol) {
    margin: 0 0 0.85rem 1.1rem;
  }
  .cl-list :global(.cl-notes a) {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cl-list :global(.cl-notes code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
    color: var(--c-olive);
  }
  .cl-empty {
    max-width: 36rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    align-items: center;
  }
  .cl-empty p {
    flex: 1 1 100%;
    margin: 0 0 0.4rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
  }
</style>
