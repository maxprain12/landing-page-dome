---
import { links } from "../data/landing";
import { localeFromPath, t, type Locale } from "../i18n";
import DomeIcon from "./icons/DomeIcon.astro";
import EditionSwitcher from "./EditionSwitcher.astro";

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const copy = t(locale);
const h = copy.hero;

function letters(word: string) {
  return [...word].map((ch, i, all) => ({ ch, i, n: Math.max(all.length - 1, 1) }));
}
---

<section
  class="hero"
  data-hero
  data-hero-story
  data-pillar="documentos"
  data-edition="pro"
  data-phase="peek"
  style="--reveal: 0; --split: 0;"
>
  <div class="hero-track" data-story-track id="ediciones">
    <div class="hero-pin" data-story-pin>
      <div class="hero-copy" data-hero-copy>
        <h1 class="hero-title">
          {h.h1Lead}<button
            type="button"
            class="hero-word"
            data-hero-pill="documentos"
            data-view="library"
            aria-label={h.h1Documentos}
          >{letters(h.h1Documentos).map((l) => (
              <span class="hero-letter" style={`--i:${l.i};--n:${l.n}`}>{l.ch}</span>
            ))}</button>{h.h1Mid}<button
            type="button"
            class="hero-word"
            data-hero-pill="many"
            data-view="draft"
            aria-label={h.h1Acciones}
          >{letters(h.h1Acciones).map((l) => (
              <span class="hero-letter" style={`--i:${l.i};--n:${l.n}`}>{l.ch}</span>
            ))}</button>{h.h1Mid2}<button
            type="button"
            class="hero-word"
            data-hero-pill="personas"
            data-view="person"
            aria-label={h.h1Contexto}
          >{letters(h.h1Contexto).map((l) => (
              <span class="hero-letter" style={`--i:${l.i};--n:${l.n}`}>{l.ch}</span>
            ))}</button>{h.h1End}
        </h1>
        <p class="hero-sub">{h.subhead}</p>
        <div class="hero-cta">
          <a class="btn btn-primary hero-download" href={links.releases} target="_blank" rel="noopener">
            {h.primaryCta}
          </a>
          <a class="btn-text hero-more" href="#como-funciona">
            {h.secondaryCta}
            <DomeIcon name="arrow" size={18} />
          </a>
        </div>
      </div>
      <EditionSwitcher locale={locale} />
    </div>
  </div>
  <p class="story-note">{copy.editions.note}</p>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-hero]").forEach((hero) => {
    const setPillar = (id: string, view?: string) => {
      if (hero.dataset.phase === "editions") return;
      hero.dataset.pillar = id;
      const shell = hero.querySelector<HTMLElement>("[data-appshell]");
      if (shell && view) shell.dataset.view = view;
    };
    hero.querySelectorAll<HTMLButtonElement>("[data-hero-pill]").forEach((btn) => {
      const id = btn.dataset.heroPill;
      const view = btn.dataset.view;
      if (!id) return;
      btn.addEventListener("mouseenter", () => setPillar(id, view));
      btn.addEventListener("focus", () => setPillar(id, view));
      btn.addEventListener("click", () => setPillar(id, view));
    });
  });
</script>

<style>
  .hero {
    position: relative;
    background-color: transparent;
    background-image: none;
    color: var(--hero-text);
    --reveal: 0;
    --split: 0;
  }
  .hero-track {
    position: relative;
  }
  .hero-pin {
    position: relative;
    min-height: auto;
    display: flex;
    flex-direction: column;
    padding: 4.5rem 1.25rem 0.5rem;
    overflow: hidden;
    z-index: 1;
    isolation: isolate;
  }
  :global(html.hero-pin) .hero-track .hero-pin {
    --rail-w: 16.5rem;
    display: flex;
    flex-direction: column;
    height: calc(100svh - var(--nav-h, 4.75rem));
    min-height: 0;
    max-height: calc(100svh - var(--nav-h, 4.75rem));
    padding: 0.85rem 0.9rem 0.5rem;
  }
  .hero-copy {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: min(1120px, 94vw);
    margin: 0 auto;
    flex: 0 0 auto;
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  :global(html.hero-pin) .hero-copy {
    position: relative;
    flex: 0 0 auto;
    min-height: 0;
    width: min(1120px, 94vw);
    max-height: calc((1 - var(--reveal)) * 24rem);
    opacity: calc(1 - var(--reveal) * 1.15);
    transform: translate3d(0, calc(var(--reveal) * -24px), 0);
    overflow: hidden;
    padding-bottom: calc((1 - var(--reveal)) * 0.7rem);
    pointer-events: none;
  }
  :global(html.hero-pin) .hero[data-phase="peek"] .hero-copy,
  :global(html.hero-pin) .hero[data-phase="full"] .hero-copy {
    pointer-events: auto;
  }
  .hero-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.45rem, 5.5vw, 4.15rem);
    line-height: 1.04;
    letter-spacing: -0.045em;
    color: #fafafa;
    margin: 0 auto 0.5rem;
    max-width: 16.5em;
    text-wrap: balance;
    animation: hero-appear 0.55s ease-out both;
  }
  .hero-sub {
    max-width: 36rem;
    margin: 0 auto;
    font-size: clamp(0.95rem, 1.5vw, 1.12rem);
    line-height: 1.45;
    font-weight: 500;
    color: #a1a1aa;
    text-wrap: pretty;
    animation: hero-appear 0.55s ease-out 0.12s both;
  }
  .hero-word {
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    margin: 0;
    font: inherit;
    color: inherit;
    cursor: pointer;
    position: relative;
    display: inline;
    white-space: nowrap;
  }
  .hero-word[data-hero-pill="documentos"] {
    --hue: 72;
  }
  .hero-word[data-hero-pill="many"] {
    --hue: 196;
  }
  .hero-word[data-hero-pill="personas"] {
    --hue: 308;
  }
  .hero-letter {
    display: inline-block;
    color: inherit;
  }
  .hero-word:hover .hero-letter,
  .hero-word:focus-visible .hero-letter {
    color: hsl(calc(var(--hue) + (320 * var(--i) / var(--n))) 78% 70%);
  }
  .hero-word::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.04em;
    height: 0.07em;
    border-radius: 99px;
    opacity: 0;
    background: linear-gradient(
      90deg,
      #e0eab4,
      #cfd1eb,
      #7dd3fc,
      #f9a8d4,
      #fde68a,
      #e0eab4
    );
    pointer-events: none;
  }
  .hero-word:hover::after,
  .hero-word:focus-visible::after {
    opacity: 1;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.55rem 1.4rem;
    margin-top: 0.85rem;
    animation: hero-appear 0.55s ease-out 0.24s both;
  }
  .hero-download {
    font-size: 1.12rem;
    padding: 1.05rem 1.85rem;
    min-height: 3.15rem;
  }
  .hero-more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1.05rem;
    padding: 1.05rem 0.45rem;
  }
  .story-note {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 1.4rem 1.25rem 2.2rem;
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    text-align: center;
    background: var(--color-bg);
  }
  @keyframes hero-appear {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-title,
    .hero-sub,
    .hero-cta {
      animation: none;
    }
  }
  @media (max-width: 700px) {
    .hero-title {
      max-width: none;
    }
  }
  @media (max-width: 860px) {
    .hero-pin,
    :global(html.hero-pin) .hero-track .hero-pin {
      --rail-w: 0px;
      height: auto;
      min-height: 0;
      max-height: none;
      overflow: visible;
      padding: 1.1rem 1.05rem 1.5rem;
    }
    .hero-copy,
    :global(html.hero-pin) .hero-copy {
      width: 100%;
      max-height: none;
      overflow: visible;
      opacity: 1;
      transform: none;
      padding-bottom: 0.7rem;
      pointer-events: auto;
    }
    .hero-title {
      font-size: clamp(2.05rem, 8.2vw, 2.55rem);
      line-height: 1.08;
      letter-spacing: -0.04em;
      margin-bottom: 0.35rem;
    }
    .hero-sub {
      font-size: 0.88rem;
      line-height: 1.4;
    }
    .hero-cta {
      flex-direction: column;
      gap: 0.15rem;
      margin-top: 0.55rem;
    }
    .hero-download {
      font-size: 1rem;
      padding: 0.82rem 1.4rem;
      min-height: 2.8rem;
    }
    .hero-more {
      font-size: 0.95rem;
      padding: 0.5rem 0.3rem;
    }
    .story-note {
      padding: 0.25rem 0 1.5rem;
    }
  }
</style>
