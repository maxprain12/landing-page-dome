---
import { hero, manyDemo } from "../data/landing";
---

<section class="hero">
  <div class="wrap hero-in">
    <div class="hero-copy">
      <p class="eyebrow" data-reveal>— {hero.eyebrow}</p>
      <h1 class="h-display hero-title" data-reveal>
        {hero.title}<br />
        <span class="hero-accent">{hero.titleAccent}</span>
      </h1>
      <p class="hero-sub" data-reveal>{hero.subtitle}</p>
      <div class="hero-cta" data-reveal>
        <a class="btn btn-primary" href={hero.primaryCta.href} target="_blank" rel="noopener">
          {hero.primaryCta.label}
        </a>
        <a class="btn btn-ghost" href={hero.secondaryCta.href} target="_blank" rel="noopener">
          {hero.secondaryCta.label}
        </a>
      </div>
      <ul class="hero-proof" data-reveal>
        {hero.proof.map((p) => <li>{p}</li>)}
      </ul>
    </div>

    <div class="hero-art" data-reveal>
      <div class="hero-chat appwin" data-many-chat>
        <div class="appwin-bar">
          <span class="appwin-dot" style="background:#e5756a"></span>
          <span class="appwin-dot" style="background:#ebb447"></span>
          <span class="appwin-dot" style="background:#6ac47f"></span>
          <span class="appwin-title">Dome · Many</span>
        </div>

        <div class="hero-thread" data-thread>
          <div class="hc-msg hc-ai">
            <img class="hc-avatar" src={hero.mascot} alt="Many" width="28" height="28" />
            <div class="hc-bubble">{manyDemo.greeting}</div>
          </div>
        </div>

        <div class="hero-prompts" data-prompts>
          <span class="hero-prompts-l">Try asking —</span>
          <div class="hero-prompts-row">
            {manyDemo.questions.map((item) => (
              <button type="button" class="hero-chip" data-q={item.q} data-a={item.a}>
                {item.q}
              </button>
            ))}
          </div>
          <p class="hero-done">✦ You've met Many — now meet your library.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Many como chat de Dome: pulsar un prompt añade tu mensaje + Many "escribe" y responde.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLElement>("[data-many-chat]").forEach((root) => {
    const thread = root.querySelector<HTMLElement>("[data-thread]");
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>(".hero-chip"));
    const mascot = root.querySelector<HTMLImageElement>(".hc-avatar")?.src || "";
    if (!thread) return;
    const asked = new Set<string>();
    let busy = false;

    const scroll = () => (thread.scrollTop = thread.scrollHeight);
    const addUser = (text: string) => {
      const el = document.createElement("div");
      el.className = "hc-msg hc-user";
      el.innerHTML = `<div class="hc-bubble">${text}</div>`;
      thread.appendChild(el);
      scroll();
    };
    const addAI = (text: string) => {
      const el = document.createElement("div");
      el.className = "hc-msg hc-ai";
      el.innerHTML =
        `<img class="hc-avatar" src="${mascot}" alt="Many" width="28" height="28" />` +
        `<div class="hc-bubble"><span class="hc-typing"><i></i><i></i><i></i></span></div>`;
      thread.appendChild(el);
      scroll();
      const bubble = el.querySelector<HTMLElement>(".hc-bubble")!;
      const reveal = () => {
        if (reduce) {
          bubble.textContent = text;
          scroll();
          busy = false;
          return;
        }
        let i = 0;
        let last = 0;
        const step = (t: number) => {
          if (t - last > 16) {
            i += 1;
            bubble.textContent = text.slice(0, i);
            last = t;
            scroll();
          }
          if (i < text.length) requestAnimationFrame(step);
          else busy = false;
        };
        requestAnimationFrame(step);
      };
      window.setTimeout(reveal, reduce ? 0 : 650);
    };

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        if (busy) return;
        busy = true;
        chip.setAttribute("data-asked", "1");
        asked.add(chip.dataset.q || "");
        addUser(chip.dataset.q || "");
        addAI(chip.dataset.a || "");
        if (asked.size === chips.length) root.setAttribute("data-complete", "1");
      });
    });
  });
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--color-bg);
  }
  .hero-in {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 3rem;
    align-items: center;
    padding: clamp(3rem, 7vw, 5.5rem) 0 clamp(3.5rem, 8vw, 6rem);
  }
  .hero-title {
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    margin: 1rem 0 1.2rem;
  }
  .hero-accent {
    font-style: italic;
    color: var(--color-accent);
  }
  .hero-sub {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 34rem;
    margin: 0 0 2rem;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-bottom: 1.6rem;
  }
  .hero-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-ink-3);
  }
  .hero-proof li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .hero-proof li::before {
    content: "✦";
    color: var(--color-rust);
  }

  /* Dome chat */
  .hero-chat {
    max-width: 25rem;
    margin: 0 auto;
  }
  .hero-thread {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1rem;
    height: 17rem;
    overflow-y: auto;
    background: var(--color-surface);
  }
  /* chat bubble styles live in the is:global block below
     (so JS-appended messages get styled too) */

  .hero-prompts {
    border-top: 1px dashed var(--color-border);
    padding: 0.8rem 1rem 1rem;
    background: var(--color-surface);
  }
  .hero-prompts-l {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }
  .hero-prompts-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }
  .hero-chip {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    cursor: pointer;
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      transform 0.15s ease;
  }
  .hero-chip:hover {
    background: var(--c-mint);
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }
  .hero-chip[data-asked] {
    border-style: dashed;
    color: var(--color-ink-3);
  }
  .hero-done {
    display: none;
    margin: 0.8rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-rust);
  }
  .hero-chat[data-complete] .hero-done {
    display: block;
    animation: hero-pop 0.4s ease;
  }
  @keyframes hero-pop {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  @media (max-width: 860px) {
    .hero-in {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero-copy {
      order: 2;
    }
    .hero-art {
      order: 1;
    }
    .hero-sub {
      margin-inline: auto;
    }
    .hero-cta,
    .hero-proof {
      justify-content: center;
    }
    .hero-chat {
      text-align: left;
    }
  }
</style>

<style is:global>
  /* Chat bubbles — global so JS-appended messages are styled too. */
  .hc-msg {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    max-width: 90%;
  }
  .hc-ai {
    align-self: flex-start;
  }
  .hc-user {
    align-self: flex-end;
    flex-direction: row-reverse;
  }
  .hc-avatar {
    width: 28px;
    height: 28px;
    flex: none;
    border-radius: 50%;
    background: var(--c-olive);
    padding: 3px;
  }
  .hc-bubble {
    font-size: 0.88rem;
    line-height: 1.45;
    padding: 0.55rem 0.8rem;
    border-radius: 12px;
  }
  .hc-ai .hc-bubble {
    background: var(--color-paper-deep);
    color: var(--color-text);
    border-bottom-left-radius: 3px;
  }
  .hc-user .hc-bubble {
    background: var(--color-accent);
    color: #fff;
    border-bottom-right-radius: 3px;
  }
  .hc-typing {
    display: inline-flex;
    gap: 4px;
    padding: 2px 0;
  }
  .hc-typing i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    animation: hc-blink 1.1s infinite ease-in-out;
  }
  .hc-typing i:nth-child(2) {
    animation-delay: 0.15s;
  }
  .hc-typing i:nth-child(3) {
    animation-delay: 0.3s;
  }
  @keyframes hc-blink {
    0%, 70%, 100% {
      opacity: 0.3;
    }
    35% {
      opacity: 1;
    }
  }
</style>
