---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  label: string;
}

const { headings, label } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{
  items.length ? (
    <nav class="toc" aria-label={label}>
      <p class="toc-label">{label}</p>
      <ol>
        {items.map((heading) => (
          <li class:list={[heading.depth === 3 && "is-h3"]}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  ) : null
}

<style>
  .toc {
    position: sticky;
    top: 6.2rem;
    padding: 1rem 0 1rem 1rem;
    border-left: 1px solid var(--color-border);
  }
  .toc-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    margin: 0 0 0.75rem;
  }
  ol {
    list-style: none;
    display: grid;
    gap: 0.45rem;
  }
  a {
    color: var(--color-text-secondary);
    font-size: 0.86rem;
    line-height: 1.35;
  }
  a:hover {
    color: var(--color-text);
  }
  .is-h3 {
    padding-left: 0.7rem;
  }
</style>
