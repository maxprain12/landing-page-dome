---
interface Props {
  type?: "note" | "warning" | "tip";
  title?: string;
}

const { type = "note", title } = Astro.props;
---

<aside class:list={["mdx-callout", `is-${type}`]}>
  {title ? <p class="mdx-callout-title">{title}</p> : null}
  <div class="mdx-callout-body">
    <slot />
  </div>
</aside>

<style>
  .mdx-callout {
    margin: 1.4rem 0;
    padding: 1rem 1.1rem;
    border-radius: 16px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .is-tip {
    border-color: color-mix(in srgb, var(--color-olive-fill) 35%, var(--color-border));
    background: color-mix(in srgb, var(--color-olive-muted) 55%, var(--color-surface));
  }
  .is-warning {
    border-color: color-mix(in srgb, var(--color-amber) 28%, var(--color-border));
    background: color-mix(in srgb, var(--color-amber-ink) 18%, var(--color-surface));
  }
  .mdx-callout-title {
    font-weight: 650;
    color: var(--color-text);
    margin: 0 0 0.35rem;
  }
  .mdx-callout-body {
    color: var(--color-text-secondary);
    font-size: 0.94rem;
    line-height: 1.6;
  }
  .mdx-callout-body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
