---
interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<figure class="mdx-flow">
  {title ? <figcaption class="mdx-flow-title">{title}</figcaption> : null}
  <ol class="mdx-flow-list">
    <slot />
  </ol>
</figure>

<style>
  .mdx-flow {
    margin: 1.6rem 0 1.9rem;
    padding: 1.15rem 1.15rem 0.4rem;
    border: 1px solid var(--color-border);
    border-radius: 20px;
    background: color-mix(in srgb, var(--color-surface) 78%, transparent);
  }
  .mdx-flow-title {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    margin: 0 0 0.95rem;
  }
  .mdx-flow-list {
    list-style: none;
    display: grid;
    gap: 0.7rem;
    margin: 0 0 0.85rem;
    padding: 0;
    counter-reset: flow;
  }
  .mdx-flow-list :global(.mdx-step) {
    counter-increment: flow;
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.85rem;
    align-items: start;
    padding: 0.85rem 0.9rem;
    border-radius: 14px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
  }
  .mdx-flow-list :global(.mdx-step)::before {
    content: counter(flow);
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--c-olive);
    color: var(--color-olive-ink);
    font-weight: 700;
    font-size: 0.85rem;
  }
</style>
