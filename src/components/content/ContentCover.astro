---
type CoverSize = "featured" | "grid" | "article";

interface Props {
  src?: string;
  alt: string;
  eyebrow?: string;
  title: string;
  size?: CoverSize;
  eager?: boolean;
  titleAs?: "h1" | "p";
  overlay?: boolean;
  chip?: string;
}

const {
  src,
  alt,
  eyebrow,
  title,
  size = "grid",
  eager = false,
  titleAs = "p",
  overlay = false,
  chip,
} = Astro.props;
const TitleTag = titleAs;
---

<div class:list={["cover", `is-${size}`, overlay && "has-overlay"]}>
  {
    src ? (
      <img
        src={src}
        alt={alt}
        width="1280"
        height="720"
        loading={eager ? "eager" : "lazy"}
        decoding="async"
      />
    ) : (
      <div class="cover-fallback" aria-hidden="true"></div>
    )
  }
  {
    overlay ? (
      <>
        <div class="cover-scrim" aria-hidden="true"></div>
        <div class="cover-copy">
          {eyebrow ? <p class="eyebrow">{eyebrow}</p> : null}
          <TitleTag class="cover-title">{title}</TitleTag>
        </div>
      </>
    ) : chip ? (
      <p class="cover-chip">{chip}</p>
    ) : null
  }
</div>

<style>
  .cover {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--color-surface);
  }
  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cover-fallback {
    display: block;
    width: 100%;
    height: 100%;
    min-height: inherit;
    background:
      radial-gradient(120% 90% at 50% 0%, color-mix(in srgb, var(--c-olive) 28%, transparent), transparent 62%),
      var(--color-surface);
  }
  .is-featured,
  .is-article {
    aspect-ratio: 16 / 9;
  }
  .is-grid {
    aspect-ratio: 16 / 9;
  }
  .cover-chip {
    position: absolute;
    left: 0.85rem;
    bottom: 0.85rem;
    z-index: 1;
    margin: 0;
    height: 1.7rem;
    padding: 0 0.75rem;
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    color: var(--color-text);
    font-size: 0.78rem;
    font-weight: 550;
  }
  .cover-scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        72% 58% at 50% 48%,
        color-mix(in srgb, var(--color-bg) 58%, transparent) 0%,
        color-mix(in srgb, var(--color-bg) 18%, transparent) 70%
      ),
      linear-gradient(
        to top,
        color-mix(in srgb, var(--color-bg) 88%, transparent) 0%,
        color-mix(in srgb, var(--color-bg) 22%, transparent) 58%,
        color-mix(in srgb, var(--color-olive-muted) 26%, transparent) 100%
      );
  }
  .cover-copy {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-content: center;
    gap: 0.7rem;
    padding: 1.4rem 1.5rem;
    text-align: center;
  }
  .cover-copy .eyebrow {
    color: color-mix(in srgb, var(--c-olive) 72%, var(--color-text));
  }
  .cover-title {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.12;
    color: var(--color-text);
    text-wrap: balance;
    margin: 0 auto;
    max-width: 18ch;
    text-shadow: 0 8px 28px color-mix(in srgb, var(--color-bg) 70%, transparent);
  }
  .is-featured .cover-title,
  .is-article .cover-title {
    font-size: clamp(1.55rem, 4.2vw, 2.7rem);
  }
  .is-grid .cover-title {
    font-size: clamp(1.12rem, 2.4vw, 1.42rem);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
