---
interface Props {
  src?: string;
  poster: string;
  title: string;
  caption?: string;
  transcriptLabel?: string;
}

const { src, poster, title, caption, transcriptLabel = "Transcript" } = Astro.props;
---

<figure class="mdx-video">
  {
    src ? (
      <video controls preload="metadata" poster={poster} title={title}>
        <source src={src} />
      </video>
    ) : (
      <img src={poster} alt={title} width="2800" height="1800" loading="lazy" decoding="async" />
    )
  }
  <figcaption>
    <strong>{title}</strong>
    {caption ? <span>{caption}</span> : null}
    <details>
      <summary>{transcriptLabel}</summary>
      <div class="mdx-video-transcript">
        <slot />
      </div>
    </details>
  </figcaption>
</figure>

<style>
  .mdx-video {
    margin: 1.6rem 0 1.8rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 18px;
    overflow: hidden;
  }
  video,
  img {
    display: block;
    width: 100%;
    height: auto;
  }
  figcaption {
    padding: 0.9rem 1rem 1rem;
    border-top: 1px solid var(--color-border);
    display: grid;
    gap: 0.4rem;
    font-size: 0.86rem;
    color: var(--color-text-secondary);
  }
  strong {
    color: var(--color-text);
  }
  details {
    margin-top: 0.2rem;
  }
  summary {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }
  .mdx-video-transcript {
    margin-top: 0.55rem;
    color: var(--color-text-secondary);
  }
</style>
