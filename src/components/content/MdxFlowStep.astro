---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<li class="mdx-step">
  <div>
    <p class="mdx-step-title">{title}</p>
    <div class="mdx-step-body">
      <slot />
    </div>
  </div>
</li>

<style>
  .mdx-step-title {
    margin: 0 0 0.25rem;
    font-weight: 650;
    color: var(--color-text);
  }
  .mdx-step-body {
    color: var(--color-text-secondary);
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .mdx-step-body :global(p) {
    margin: 0;
  }
</style>
