---
import { render } from "astro:content";
import Footer from "../Footer.astro";
import Nav from "../Nav.astro";
import DomeIcon from "../icons/DomeIcon.astro";
import { links } from "../../data/landing";
import { contentPath, readingMinutes, relatedEntries, type ContentEntry, type ContentKind } from "../../lib/content";
import { localizePath, t, type Locale } from "../../i18n";
import { mdxComponents } from "./mdx";

interface Props {
  locale: Locale;
  kind: ContentKind;
  entry: ContentEntry;
  siblings: ContentEntry[];
  translationPath?: string | null;
}

const { locale, kind, entry, siblings, translationPath } = Astro.props;
const copy = t(locale);
const { Content } = await render(entry);
const minutes = readingMinutes(entry.body);
const related = relatedEntries(siblings, entry);
const publishedIso = entry.data.publishedAt.toISOString().slice(0, 10);
const publishedLabel = entry.data.publishedAt.toLocaleDateString(locale === "es" ? "es-ES" : "en-US", {
  day: "numeric",
  month: "short",
  year: "numeric",
});
const indexHref = localizePath(kind === "blog" ? "/blog" : "/manual", locale);
const indexLabel = kind === "blog" ? copy.nav.blog : copy.nav.manuals;
const esHref = locale === "es" ? contentPath(kind, entry.data.permalink, "es") : (translationPath ?? undefined);
const enHref = locale === "en" ? contentPath(kind, entry.data.permalink, "en") : (translationPath ?? undefined);
const author = entry.data.author;
const initials = author
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0] ?? "")
  .join("")
  .toUpperCase();
---

<Nav locale={locale} esHref={esHref} enHref={enHref} />
<main id="main-content" class="article">
  <div class="wrap article-top">
    <a class="btn btn-ghost back" href={indexHref}>
      <span class="back-ico"><DomeIcon name="arrow" size={14} /></span>
      {copy.content.backTo} {indexLabel}
    </a>
  </div>

  <header class="article-head">
    <h1 class="article-title">{entry.data.title}</h1>
    <p class="article-lead">{entry.data.description}</p>
  </header>

  {
    entry.data.heroImage ? (
      <figure class="article-shot">
        <img
          src={entry.data.heroImage}
          alt={entry.data.heroAlt ?? entry.data.title}
          width="2800"
          height="1800"
          loading="eager"
          decoding="async"
        />
      </figure>
    ) : null
  }

  <article class="prose">
    <Content components={mdxComponents} />
  </article>

  {
    related.length ? (
      <section class="related">
        <p class="related-kicker">
          {copy.content.related}
          <span aria-hidden="true"> →</span>
        </p>
        <ul class="related-list">
          {related.map((item) => (
            <li>
              <a href={contentPath(kind, item.data.permalink, locale)}>{item.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ) : null
  }

  <footer class="article-end">
    <div class="article-bar">
      <span class="article-chip">{entry.data.category}</span>
      <span class="article-mins">{minutes} {copy.content.minutes}</span>
    </div>
    <div class="byline">
      <span class="avatar" aria-hidden="true">{initials}</span>
      <div class="byline-who">
        <p class="byline-name">{author}</p>
        <p class="byline-role">{copy.content.authorRole}</p>
      </div>
      <time datetime={publishedIso}>{publishedLabel}</time>
    </div>
  </footer>

  <div class="article-cta">
    <a class="btn btn-primary" href={links.releases} target="_blank" rel="noopener">{copy.nav.download}</a>
    <a class="btn btn-ghost" href={indexHref}>{copy.content.more} {indexLabel}</a>
  </div>
</main>
<Footer locale={locale} />

<style>
  .article {
    padding: 1.2rem 0 4.4rem;
  }
  .article-top {
    width: min(44rem, 92vw);
    margin: 0 auto 1.6rem;
  }
  .back {
    height: 2.2rem;
    padding: 0 0.95rem;
    font-size: 0.84rem;
    font-weight: 550;
  }
  .back-ico {
    display: inline-flex;
    transform: scaleX(-1);
  }
  .article-head,
  .article-end,
  .related,
  .article-cta {
    width: min(44rem, 92vw);
    margin-inline: auto;
  }
  .article-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 6.4vw, 3.7rem);
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 1.06;
    text-align: center;
    text-wrap: balance;
    margin: 0 auto;
    max-width: 18ch;
    color: var(--color-text);
  }
  .article-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.8rem;
    max-width: 32rem;
    margin: 1.7rem auto 0;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }
  .article-chip {
    display: inline-flex;
    align-items: center;
    height: 1.7rem;
    padding: 0 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: 0.82rem;
  }
  .article-mins {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--color-ink-3);
  }
  .byline {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 32rem;
    margin: 1rem auto 0;
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 2.35rem;
    height: 2.35rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    color: var(--color-text);
  }
  .byline-who {
    min-width: 0;
  }
  .byline-name {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .byline-role {
    margin: 0.12rem 0 0;
    font-size: 0.78rem;
    color: var(--color-text-secondary);
  }
  .byline time {
    margin-left: auto;
    font-size: 0.82rem;
    color: var(--color-ink-3);
    white-space: nowrap;
  }
  .article-lead {
    font-size: 1.18rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
    text-align: center;
    text-wrap: pretty;
    margin: 1.35rem auto 0;
    max-width: 36rem;
  }
  .article-shot {
    width: min(52rem, 92vw);
    margin: 2.6rem auto 2rem;
  }
  .article-shot img {
    display: block;
    width: 100%;
    height: auto;
  }
  .prose {
    width: min(42rem, 92vw);
    margin: 0 auto;
    font-size: 1.08rem;
    line-height: 1.72;
    color: var(--color-text-secondary);
  }
  .prose :global(h2) {
    font-size: 1.55rem;
    font-weight: 650;
    letter-spacing: -0.03em;
    margin: 2.4rem 0 0.85rem;
    color: var(--color-text);
    scroll-margin-top: 5.5rem;
  }
  .prose :global(h3) {
    font-size: 1.08rem;
    margin: 1.5rem 0 0.5rem;
    color: var(--color-text);
    scroll-margin-top: 5.5rem;
  }
  .prose :global(p) {
    margin: 0 0 1rem;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.1rem 1.15rem;
  }
  .prose :global(li) {
    margin-bottom: 0.45rem;
  }
  .prose :global(a) {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose :global(strong) {
    color: var(--color-text);
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
    color: var(--c-olive);
  }
  .related {
    margin-top: 2.8rem;
    padding-top: 0.4rem;
  }
  .related-kicker {
    font-size: 0.92rem;
    font-weight: 600;
    margin: 0 0 0.55rem;
    color: var(--color-lavender-soft);
  }
  .related-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }
  .related-list a {
    color: var(--color-lavender-soft);
    font-size: 1rem;
    line-height: 1.45;
  }
  .related-list a:hover {
    color: var(--color-text);
  }
  .article-end {
    margin-top: 2.4rem;
  }
  .article-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2.4rem;
  }
</style>
