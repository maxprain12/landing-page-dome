---
import Nav from "./Nav.astro";
import { localeFromPath, localeHome, t, type Locale } from "../i18n";

interface Props {
  title: string;
  eyebrow: string;
  lastUpdated: string;
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const copy = t(locale);
const { title, eyebrow, lastUpdated } = Astro.props;
---

<div class="legal-surface">
  <Nav locale={locale} />
  <main class="legal-main">
    <article class="legal-doc">
      <a href={localeHome(locale)} class="legal-back">← {copy.legal.back}</a>
      <p class="legal-ey">{eyebrow}</p>
      <h1 class="legal-h1">{title}</h1>
      <p class="legal-meta">{copy.legal.updated}: {lastUpdated}</p>
      <div class="legal-body">
        <slot />
      </div>
    </article>
  </main>
</div>

<style>
  .legal-surface {
    min-height: 100%;
    background: var(--color-bg);
  }
  .legal-main {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0.5rem clamp(1rem, 4vw, 3rem) 4.5rem;
  }
  .legal-doc {
    max-width: 42rem;
    margin: 0 auto;
  }
  .legal-back {
    display: inline-flex;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    margin-bottom: 1.75rem;
    border-bottom: 1px solid transparent;
  }
  .legal-back:hover {
    color: var(--color-text);
    border-bottom-color: var(--color-text);
  }
  .legal-ey {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-ink-3);
    margin: 0 0 0.5rem;
  }
  .legal-h1 {
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    margin: 0 0 0.65rem;
  }
  .legal-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--color-ink-3);
    margin: 0 0 2.25rem;
  }
  .legal-body {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }
</style>

<style is:global>
  .legal-body :global(h2) {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.12;
    color: var(--color-text);
    margin: 2.25rem 0 0.85rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .legal-body :global(h2:first-of-type) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }
  .legal-body :global(h3) {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 1.35rem 0 0.5rem;
  }
  .legal-body :global(p) {
    margin: 0 0 0.9rem;
  }
  .legal-body :global(ul) {
    margin: 0 0 1rem 1.1rem;
  }
  .legal-body :global(li) {
    margin-bottom: 0.4rem;
  }
  .legal-body :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }
  .legal-body :global(a) {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal-highlight {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.1rem 1.15rem 1.15rem;
    margin: 0 0 0.5rem;
    color: var(--color-text-secondary);
  }
</style>
