---
import type { ShellView } from "./appshell";
import AppShellFrame from "./AppShellFrame.astro";
import { SHOT_SIZE, shotForView } from "../data/shots";
import { localeFromPath, localizePath, t, type Locale } from "../i18n";

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const copy = t(locale);

const editions: {
  id: "pro" | "study" | "dev";
  view: ShellView;
  shot: string | null;
  name: string;
  title: string;
  text: string;
  cta: string;
  href: string;
}[] = [
  {
    id: "pro",
    view: "library",
    shot: shotForView("library"),
    name: "Pro",
    title: copy.pro.h2,
    text: copy.pro.body,
    cta: copy.editions.proCta,
    href: "/pro",
  },
  {
    id: "study",
    view: "study",
    shot: shotForView("study"),
    name: copy.editions.study.name,
    title: copy.editions.study.title,
    text: copy.editions.study.text,
    cta: copy.editions.study.cta,
    href: copy.editions.study.href,
  },
  {
    id: "dev",
    view: "dev",
    shot: shotForView("dev"),
    name: copy.editions.dev.name,
    title: copy.editions.dev.title,
    text: copy.editions.dev.text,
    cta: copy.editions.dev.cta,
    href: copy.editions.dev.href,
  },
];
---

<div class="story-stage" data-story-stage>
  <div class="story-frame" data-story-frame>
    <nav class="story-rail" data-story-rail aria-label={copy.nav.editions}>
      <h2 class="story-sr">{copy.editions.h2}</h2>
      {
        editions.map((edition, i) => (
          <article
            class="story-item"
            data-edition={edition.id}
            data-active={i === 0 ? "" : undefined}
          >
            <button
              type="button"
              class="story-tab"
              data-edition-tab={edition.id}
              data-view={edition.view}
              data-shot={edition.shot ?? ""}
              aria-expanded={i === 0}
            >
              <span class="story-name">{edition.name}</span>
            </button>
            <div class="story-body">
              <div class="story-body-in">
                <p class="story-title">{edition.title}</p>
                <p class="story-text">{edition.text}</p>
                <a class="story-cta" href={localizePath(edition.href, locale)}>
                  {edition.cta}
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </nav>

    <div class="story-window" data-story-window id="demo">
      <AppShellFrame copy={copy} view="library" shot={shotForView("library")} priority />
      {
        editions.map((edition) =>
          edition.shot ? (
            <img
              class="story-photo"
              data-story-photo={edition.id}
              src={edition.shot}
              alt=""
              width={SHOT_SIZE.width}
              height={SHOT_SIZE.height}
              loading="lazy"
              decoding="async"
            />
          ) : null,
        )
      }
    </div>
  </div>
</div>

<style>
  .story-stage {
    flex: 1 1 0;
    min-height: 0;
    min-width: 0;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr;
    align-items: stretch;
    width: min(1240px, 100%);
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  .story-rail {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 0;
    width: 100%;
    min-width: 0;
    padding: 0;
  }
  .story-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .story-frame {
    display: contents;
  }
  .story-item {
    position: relative;
    padding: 0.75rem 0 0.55rem;
  }
  .story-item:first-of-type {
    padding-top: 0.2rem;
  }
  .story-item::before,
  .story-item::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 1px;
    transform-origin: left center;
  }
  .story-item::before {
    background: rgba(255, 255, 255, 0.16);
  }
  .story-item::after {
    background: var(--color-text);
    transform: scaleX(0);
  }
  .story-item[data-active]::after {
    transform: scaleX(var(--rail-fill, 1));
  }
  .story-tab {
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    margin: 0;
    font: inherit;
    color: inherit;
    cursor: pointer;
    text-align: left;
    width: 100%;
  }
  .story-name {
    display: block;
    font-size: 0.92rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: rgba(250, 250, 250, 0.38);
    transition: color 0.3s ease;
  }
  .story-item[data-active] .story-name {
    color: var(--color-text);
    font-weight: 600;
  }
  .story-body {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.45s ease,
      opacity 0.35s ease;
  }
  .story-item[data-active] .story-body {
    grid-template-rows: 1fr;
    opacity: 1;
  }
  .story-body-in {
    overflow: hidden;
    min-height: 0;
  }
  .story-title {
    margin: 0.4rem 0 0.4rem;
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.28;
    color: var(--color-text);
  }
  .story-text {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0 0 0.7rem;
  }
  .story-cta {
    display: block;
    width: 100%;
    max-width: 16.5em;
    margin: 0;
    padding: 0;
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.45;
    color: var(--color-text);
    text-decoration: none;
    text-wrap: pretty;
    border: 0;
    background: none;
  }
  .story-cta:hover {
    color: var(--color-many-body);
  }
  .story-window {
    position: relative;
    min-height: 0;
    min-width: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--color-zinc-75);
    border-radius: 16px;
  }
  .story-window :global(.ashell) {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    display: grid;
    place-items: center;
  }
  .story-window :global(.ashell-shot),
  .story-photo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }
  .story-photo {
    position: absolute;
    inset: 0;
    margin: auto;
    opacity: 0;
    pointer-events: none;
    z-index: 3;
    transition: opacity 0.4s ease;
  }
  .story-photo[data-on] {
    opacity: 1;
  }

  :global(html.hero-pin) .story-stage {
    display: block;
    position: relative;
    flex: 1 1 0;
    width: 100%;
    height: auto;
    min-height: 0;
    overflow: visible;
    box-sizing: border-box;
    padding-top: 0.85rem;
    container-type: size;
  }
  :global(html.hero-pin) .story-frame {
    --fit-h: min(
      100cqh,
      max(0px, calc((100cqw - var(--rail-w, 16.5rem) - 2rem) * 1920 / 2880))
    );
    display: block;
    position: absolute;
    left: 50%;
    top: 50%;
    bottom: auto;
    height: var(--fit-h);
    width: calc(var(--fit-h) * 2880 / 1920);
    padding-left: calc(var(--split, 0) * (var(--rail-w, 0px) + 2rem));
    box-sizing: content-box;
    transform: translate3d(-50%, -50%, 0);
    will-change: transform;
    backface-visibility: hidden;
  }
  :global(html.hero-pin) .story-window {
    position: relative;
    width: 100%;
    height: 100%;
    top: auto;
    right: auto;
    bottom: auto;
    left: auto;
    transform: none;
    border-radius: 16px;
    box-shadow:
      0 28px 80px -24px rgba(0, 0, 0, calc(0.45 * (1 - var(--reveal, 0)))),
      0 0 0 1px rgba(255, 255, 255, calc(0.08 * (1 - var(--reveal, 0))));
  }
  :global(html.hero-pin) .story-rail {
    position: absolute;
    z-index: 2;
    left: 0;
    top: 0;
    bottom: auto;
    width: var(--rail-w);
    max-width: var(--rail-w);
    height: 100%;
    padding-top: 0;
    box-sizing: border-box;
    transform: none;
    opacity: var(--split, 0);
    pointer-events: none;
    overflow: visible;
    justify-content: center;
  }
  :global(.hero[data-phase="editions"]) .story-rail {
    pointer-events: auto;
  }

  :global(html:not(.hero-pin)) .story-stage {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  :global(html:not(.hero-pin)) .story-rail {
    order: 2;
  }
  :global(html:not(.hero-pin)) .story-window {
    order: 1;
    height: auto;
    box-shadow: 0 28px 80px -24px rgba(0, 0, 0, 0.45);
  }
  :global(html:not(.hero-pin)) .story-window :global(.ashell),
  :global(html:not(.hero-pin)) .story-window :global(.ashell-shot) {
    width: 100%;
    height: auto;
    max-width: 100%;
  }

  @media (max-width: 860px) {
    :global(html.hero-pin) .story-stage,
    .story-stage {
      display: flex;
      flex-direction: column;
      position: relative;
      flex: 0 0 auto;
      width: 100%;
      height: auto;
      min-height: 0;
      overflow: visible;
      gap: 0.85rem;
      padding-top: 0;
      container-type: normal;
    }
    :global(html.hero-pin) .story-frame,
    .story-frame {
      display: contents;
      position: static;
      left: auto;
      right: auto;
      top: auto;
      bottom: auto;
      width: auto;
      height: auto;
      padding-left: 0;
      transform: none;
    }
    :global(html.hero-pin) .story-window,
    .story-window {
      position: relative;
      order: 1;
      left: auto;
      right: auto;
      top: auto;
      bottom: auto;
      width: 100%;
      height: auto;
      transform: none;
      box-shadow: 0 28px 80px -24px rgba(0, 0, 0, 0.45);
    }
    :global(html.hero-pin) .story-rail,
    .story-rail {
      position: relative;
      order: 2;
      left: auto;
      right: auto;
      top: auto;
      bottom: auto;
      z-index: 2;
      width: 100%;
      max-width: none;
      height: auto;
      padding-top: 0;
      transform: none;
      opacity: 1;
      pointer-events: auto;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 0.4rem;
    }
    .story-item {
      padding: 0;
      flex: 0 0 auto;
    }
    .story-item::before,
    .story-item::after {
      display: none;
    }
    .story-body,
    .story-text,
    .story-title,
    .story-cta {
      display: none;
    }
    .story-name {
      padding: 0.42rem 0.9rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.08);
      color: rgba(250, 250, 250, 0.72);
      font-size: 0.82rem;
    }
    .story-item[data-active] .story-name {
      background: var(--color-text);
      color: var(--color-bg);
    }
    .story-window :global(.ashell),
    .story-window :global(.ashell-shot) {
      width: 100%;
      height: auto;
      max-width: 100%;
    }
  }
</style>
