---
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import { downloadUrl } from "../data/landing";
import { comparisons, comparisonPath, type Comparison } from "../data/comparisons";
import { localizePath, type Locale } from "../i18n";

interface Props { locale: Locale; comparison?: Comparison }
const { locale, comparison } = Astro.props;
const isEs = locale === "es";
const indexHref = localizePath("/conectores", locale);
const copy = comparison?.locales[locale];
const related = comparison ? comparisons.filter((item) => item.slug !== comparison.slug).slice(0, 4) : [];
const date = isEs ? "6 de noviembre de 2026" : "November 6, 2026";
---

<Nav locale={locale} />
<main class="compare" id="main-content">
  {comparison && copy ? (
    <>
      <div class="compare-narrow">
        <a class="back" href={indexHref}>← {isEs ? "Todas las comparaciones" : "All comparisons"}</a>
        <div class="versus" aria-hidden="true">
          <span class="brand-icon dome"><img src="/assets/many.png" alt="" width="39" height="39" /></span>
          <span class="versus-label">VS</span>
          <span class:list={["brand-icon", comparison.tone]}>{comparison.icon ? <img src={comparison.icon} alt="" width="34" height="34" /> : comparison.mark}</span>
        </div>
        <header class="hero hero-detail">
          <p class="eyebrow">{isEs ? "COMPARATIVA" : "COMPARISON"} · {copy.category}</p>
          <h1>Dome vs {comparison.name}</h1>
          <p class="hero-lead">{copy.teaser}</p>
          <p class="reviewed">{isEs ? "Comprobado el" : "Reviewed on"} {date} · <a href="#fuentes">{isEs ? "Fuentes" : "Sources"}</a></p>
        </header>

        <section class="compare-section opening" aria-labelledby="quick-heading">
          <h2 id="quick-heading">{isEs ? "La respuesta corta" : "The short answer"}</h2>
          <p class="answer">{copy.answer}</p>
          <div class="choice-grid">
            <div class="choice-card dome-choice">
              <h3><span class="brand-icon mini dome"><img src="/assets/many.png" alt="" width="24" height="24" /></span>{isEs ? "Elige Dome si" : "Choose Dome if"}</h3>
              <ul>{copy.domeFor.map((point) => <li>{point}</li>)}</ul>
            </div>
            <div class="choice-card">
              <h3><span class:list={["brand-icon", "mini", comparison.tone]}>{comparison.icon ? <img src={comparison.icon} alt="" width="19" height="19" /> : comparison.mark}</span>{isEs ? `Elige ${comparison.name} si` : `Choose ${comparison.name} if`}</h3>
              <ul>{copy.rivalFor.map((point) => <li>{point}</li>)}</ul>
            </div>
          </div>
        </section>

        <section class="compare-section" aria-labelledby="overview-heading">
          <h2 id="overview-heading">{isEs ? "De un vistazo" : "At a glance"}</h2>
          <div class="table-scroll">
            <table>
              <thead><tr><th scope="col">{isEs ? "Tema" : "Topic"}</th><th scope="col">Dome</th><th scope="col">{comparison.name}</th></tr></thead>
              <tbody>{copy.rows.map((row) => <tr><th scope="row">{row.topic}</th><td>{row.dome}</td><td>{row.rival}</td></tr>)}</tbody>
            </table>
          </div>
        </section>

        <section class="compare-section" aria-labelledby="questions-heading">
          <h2 id="questions-heading">{isEs ? "Preguntas" : "Questions"}</h2>
          <div class="questions">{copy.questions.map((item) => <div><h3>{item.q}</h3><p>{item.a}</p></div>)}</div>
        </section>

        <section class="compare-section" id="fuentes" aria-labelledby="sources-heading">
          <h2 id="sources-heading">{isEs ? "Fuentes" : "Sources"}</h2>
          <p class="source-note">{isEs ? "Comparación basada en las páginas oficiales de cada producto y en las funciones y manuales publicados por Dome. Las capacidades dependen de la versión, el plan y la configuración; comprueba el producto antes de decidir." : "Based on each product's official pages and Dome's published features and manuals. Capabilities depend on version, plan and setup; check the product before deciding."}</p>
          <ul class="sources">{comparison.source.map((item) => <li><a href={item.url} target="_blank" rel="noopener noreferrer">{item.label} ↗</a></li>)}</ul>
        </section>

        <aside class="cta" aria-label={isEs ? "Probar Dome" : "Try Dome"}>
          <div><p class="eyebrow">DOME</p><h2>{isEs ? "Trabaja con tus fuentes." : "Work with your sources."}</h2><p>{isEs ? "Empieza con un proyecto, importa un archivo y pregunta a Many." : "Start a project, import a file and ask Many."}</p></div>
          <a class="btn btn-primary" href={downloadUrl(locale)}>{isEs ? "Descargar Dome" : "Download Dome"} <span aria-hidden="true">↗</span></a>
        </aside>

        <section class="compare-section related" aria-labelledby="related-heading">
          <h2 id="related-heading">{isEs ? "Otras comparaciones" : "Other comparisons"}</h2>
          <div class="related-grid">{related.map((item) => <a href={comparisonPath(item.slug, locale)} class="related-card"><span class:list={["brand-icon", "small", item.tone]} aria-hidden="true">{item.icon ? <img src={item.icon} alt="" width="25" height="25" /> : item.mark}</span><span><strong>Dome vs {item.name}</strong><small>{item.locales[locale].teaser}</small></span><span class="arrow" aria-hidden="true">↗</span></a>)}</div>
          <a class="all-link" href={indexHref}>{isEs ? "Ver todas las comparaciones" : "View all comparisons"} →</a>
        </section>
      </div>
    </>
  ) : (
    <div class="compare-wide">
      <header class="hero hero-index">
        <p class="eyebrow">{isEs ? "DOME · COMPARAR" : "DOME · COMPARE"}</p>
        <h1>{isEs ? "Conectores" : "Connectors"}</h1>
        <p class="hero-lead">{isEs ? "Una forma clara de situar Dome frente a las herramientas que ya conoces." : "A clear way to place Dome alongside the tools you already know."}</p>
        <p class="hero-note">{isEs ? "Estas fichas comparan productos; no indican que exista una integración con cada uno." : "These profiles compare products; they do not imply an integration with each one."}</p>
      </header>
      <div class="index-grid">{comparisons.map((item) => <a class="index-card" href={comparisonPath(item.slug, locale)}><span class:list={["brand-icon", item.tone]} aria-hidden="true">{item.icon ? <img src={item.icon} alt="" width="34" height="34" /> : item.mark}</span><span class="index-text"><small>{item.locales[locale].category}</small><strong>Dome vs {item.name}</strong><span>{item.locales[locale].teaser}</span></span><span class="arrow" aria-hidden="true">↗</span></a>)}</div>
      <p class="index-date">{isEs ? "Fuentes oficiales revisadas el" : "Official sources reviewed on"} {date}. {isEs ? "Cada ficha enlaza las páginas consultadas." : "Each profile links to the pages consulted."}</p>
    </div>
  )}
</main>
<Footer locale={locale} />

<style>
  .compare { padding: 2.5rem 1.2rem 6rem; }
  .compare-narrow { width: min(940px, 100%); margin: 0 auto; }
  .compare-wide { width: min(1080px, 100%); margin: 0 auto; }
  .back { color: var(--color-text-secondary); font-size: .94rem; }
  .back:hover, .reviewed a:hover, .sources a:hover, .all-link:hover { color: var(--color-text); }
  .versus { display: flex; align-items: center; justify-content: center; gap: 1.1rem; margin: 2.1rem 0 1.45rem; }
  .versus-label { color: var(--color-text-secondary); font-weight: 700; }
  .brand-icon { display: inline-flex; align-items: center; justify-content: center; flex: none; width: 56px; height: 56px; border-radius: 15px; font-size: 2rem; font-weight: 800; letter-spacing: -.08em; color: var(--color-white); background: var(--color-compare-default); border: 1px solid rgba(255,255,255,.1); font-family: var(--font-sans); }
  .brand-icon.dome { background: var(--color-compare-dome); border-color: var(--color-compare-dome-border); }
  .brand-icon.dome img { display: block; object-fit: contain; }
  .brand-icon img { display: block; object-fit: contain; }
  .brand-icon.notion { background: var(--color-compare-icon-bg); color: var(--color-compare-notion-ink); font-family: Georgia, serif; }
  .brand-icon.google { background: var(--color-compare-icon-bg); color: var(--color-compare-google); font-family: Georgia, serif; }
  .brand-icon.microsoft { background: var(--color-compare-icon-bg); color: var(--color-compare-microsoft); font-size: 2.7rem; }
  .brand-icon.clickup { background: var(--color-compare-clickup-bg); color: var(--color-compare-clickup); font-size: 3rem; transform: none; }
  .brand-icon.notebooklm { background: var(--color-compare-notebook-bg); color: var(--color-compare-notebook); }
  .brand-icon.canva { background: var(--color-compare-canva); color: var(--color-white); font-family: Georgia, serif; font-style: italic; }
  .brand-icon.github { background: var(--color-compare-icon-bg); color: var(--color-compare-github); }
  .brand-icon.obsidian { background: var(--color-compare-obsidian-bg); color: var(--color-compare-obsidian); }
  .brand-icon.mini { width: 29px; height: 29px; border-radius: 9px; font-size: 1rem; letter-spacing: -.06em; }
  .brand-icon.mini.microsoft, .brand-icon.mini.clickup { font-size: 1.3rem; }
  .brand-icon.small { width: 43px; height: 43px; border-radius: 12px; font-size: 1.45rem; }
  .hero { text-align: center; }
  .hero-detail { margin-bottom: 3.8rem; }
  .hero .eyebrow { color: var(--color-olive-wash); letter-spacing: .15em; font-size: .7rem; }
  .hero h1 { font-size: clamp(2.8rem, 6.5vw, 5.2rem); letter-spacing: -.065em; line-height: 1.05; margin: .55rem 0 1rem; }
  .hero-lead { color: var(--color-text-secondary); font-size: clamp(1rem, 1.7vw, 1.22rem); line-height: 1.55; max-width: 41rem; margin: 0 auto; }
  .reviewed { margin: 1.8rem 0 0; color: var(--color-muted-strong); font-size: .88rem; }
  .reviewed a { text-decoration: underline; text-underline-offset: 3px; }
  .compare-section { margin: 0 0 3.7rem; }
  .compare-section h2 { font-size: clamp(1.55rem, 3vw, 2rem); letter-spacing: -.04em; margin: 0 0 1.2rem; }
  .answer, .source-note { color: var(--color-text-secondary); font-size: 1rem; line-height: 1.72; max-width: 50rem; }
  .answer { margin: 0 0 1.6rem; }
  .choice-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .choice-card { background: var(--color-compare-surface); border: 1px solid var(--color-border); border-radius: 21px; padding: 1.25rem 1.35rem; }
  .choice-card.dome-choice { border-color: var(--color-compare-border); }
  .choice-card h3 { display: flex; align-items: center; gap: .55rem; font-size: 1.02rem; letter-spacing: -.02em; margin: 0 0 1rem; }
  .choice-card ul { padding-left: 1.2rem; margin: 0; color: var(--color-zinc-100); line-height: 1.55; }
  .choice-card li { padding-left: .1rem; margin: .7rem 0; }
  .choice-card li::marker { color: var(--color-many-body); }
  .table-scroll { overflow-x: auto; border: 1px solid var(--color-border); border-radius: 19px; }
  table { width: 100%; min-width: 650px; border-collapse: collapse; text-align: left; }
  th, td { padding: 1rem 1.05rem; border-bottom: 1px solid var(--color-border); vertical-align: top; line-height: 1.55; }
  tr:last-child th, tr:last-child td { border-bottom: 0; }
  th { color: var(--color-text); font-size: .93rem; }
  thead { background: var(--color-compare-header); }
  thead th { font-weight: 650; }
  tbody th { width: 17%; font-weight: 650; }
  tbody td { width: 41.5%; color: var(--color-compare-body); border-left: 1px solid var(--color-border); }
  tbody td:nth-child(2) { background: rgba(255,255,255,.025); }
  .questions { display: grid; gap: 1rem; }
  .questions h3 { font-size: 1rem; margin: 0 0 .4rem; }
  .questions p { margin: 0; color: var(--color-text-secondary); line-height: 1.65; }
  .source-note { margin: 0 0 .85rem; }
  .sources { list-style: none; padding: 0; margin: 0; display: grid; gap: .45rem; }
  .sources a { text-decoration: underline; text-underline-offset: 3px; }
  .cta { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; border: 1px solid var(--color-compare-border); border-radius: 23px; padding: 1.5rem 1.6rem; margin: 0 0 3.7rem; background: radial-gradient(circle at 88% 8%, rgba(163,181,106,.12), transparent 37%), var(--color-compare-surface); }
  .cta .eyebrow { color: var(--color-olive-wash); margin: 0 0 .5rem; }
  .cta h2 { font-size: 1.5rem; margin: 0 0 .3rem; }
  .cta p:last-child { color: var(--color-text-secondary); margin: 0; }
  .cta .btn { white-space: nowrap; }
  .related-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .85rem; }
  .related-card { display: flex; gap: .85rem; align-items: center; border: 1px solid var(--color-border); border-radius: 17px; padding: .9rem; background: var(--color-compare-surface); }
  .related-card:hover, .index-card:hover { border-color: var(--color-compare-hover-border); background: var(--color-compare-hover); }
  .related-card > span:nth-child(2) { display: grid; gap: .2rem; min-width: 0; }
  .related-card strong { font-size: .96rem; }
  .related-card small { color: var(--color-text-secondary); line-height: 1.4; font-size: .8rem; }
  .arrow { color: var(--color-olive-wash); margin-left: auto; align-self: flex-start; }
  .all-link { display: inline-block; margin-top: 1.3rem; text-decoration: underline; text-underline-offset: 3px; }
  .hero-index { max-width: 47rem; margin: 1.8rem auto 2.6rem; }
  .hero-index h1 { font-size: clamp(3.5rem, 8vw, 6.5rem); }
  .hero-note { color: var(--color-muted-strong); font-size: .86rem; line-height: 1.55; margin: 1.2rem 0 0; }
  .index-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .9rem; }
  .index-card { display: flex; align-items: flex-start; gap: 1rem; min-height: 128px; padding: 1.1rem; border: 1px solid var(--color-border); border-radius: 19px; background: var(--color-compare-surface); transition: border-color .18s, background .18s; }
  .index-text { display: grid; gap: .25rem; min-width: 0; }
  .index-text small { color: var(--color-olive-wash); font-size: .72rem; letter-spacing: .09em; text-transform: uppercase; }
  .index-text strong { font-size: 1.14rem; letter-spacing: -.03em; }
  .index-text > span { color: var(--color-text-secondary); line-height: 1.45; font-size: .9rem; }
  .index-date { color: var(--color-muted-strong); font-size: .85rem; margin-top: 1.3rem; }
  @media (max-width: 700px) { .choice-grid, .related-grid, .index-grid { grid-template-columns: 1fr; } .hero-detail { margin-bottom: 2.8rem; } .compare { padding-top: 1.3rem; } .cta { align-items: flex-start; flex-direction: column; } .cta .btn { width: 100%; } }
</style>
