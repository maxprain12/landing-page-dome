---
import Nav from "./Nav.astro";
import Hero from "./Hero.astro";
import HowItWorks from "./HowItWorks.astro";
import Trust from "./Trust.astro";
import SocialProof from "./SocialProof.astro";
import FAQ from "./FAQ.astro";
import FinalCTA from "./FinalCTA.astro";
import Footer from "./Footer.astro";
import Pricing from "./Pricing.astro";
import { flags } from "../data/landing";
import type { Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Nav locale={locale} />
<main>
  <Hero locale={locale} />
  <HowItWorks locale={locale} />
  <Trust locale={locale} />
  {flags.showPricing ? <Pricing /> : null}
  <SocialProof locale={locale} />
  <FAQ locale={locale} />
  <FinalCTA locale={locale} />
</main>
<Footer locale={locale} />
