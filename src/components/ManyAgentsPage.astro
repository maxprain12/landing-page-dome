---
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import { manyAgentsPages } from "../data/many-agents";
import type { Locale } from "../i18n";

interface Props { locale: Locale }

const { locale } = Astro.props;
const page = manyAgentsPages[locale];
const siteUrl = `https://manyagents.dowi.es/?lang=${locale}`;
const downloadUrl = `https://manyagents.dowi.es/download?lang=${locale}`;
const accessUrl = `${siteUrl}#join`;
---

<Nav locale={locale} />
<main class="ma" id="main-content">
  <section class="wrap ma-hero" aria-labelledby="ma-title">
    <p class="eyebrow">{page.eyebrow}</p>
    <h1 class="h-display ma-h1" id="ma-title">{page.h1}</h1>
    <p class="ma-lead">{page.lead}</p>
    <div class="ma-actions">
      <a class="btn btn-primary" href={siteUrl}>{page.explore} <span aria-hidden="true">↗</span></a>
      <a class="btn btn-ghost" href={downloadUrl}>{page.download} <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="wrap ma-relation" aria-labelledby="ma-relation-title">
    <div class="ma-section-head">
      <p class="eyebrow">{page.relationEyebrow}</p>
      <h2 id="ma-relation-title">{page.relationTitle}</h2>
    </div>
    <div class="ma-pair">
      <div class="ma-product">
        <span class="ma-product-index" aria-hidden="true">01 / D</span>
        <h3>{page.domeTitle}</h3>
        <p>{page.domeText}</p>
      </div>
      <div class="ma-product ma-product-many">
        <span class="ma-product-index" aria-hidden="true">02 / M</span>
        <h3>{page.agentsTitle}</h3>
        <p>{page.agentsText}</p>
      </div>
    </div>
    <p class="ma-account">{page.accountNote}</p>
  </section>

  <section class="wrap ma-capabilities" aria-labelledby="ma-capabilities-title">
    <div class="ma-section-head">
      <p class="eyebrow">{page.capabilitiesEyebrow}</p>
      <h2 id="ma-capabilities-title">{page.capabilitiesTitle}</h2>
    </div>
    <ol class="ma-capability-list">
      {page.capabilities.map((item) => (
        <li>
          <span class="ma-number" aria-hidden="true">{item.number}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap ma-example" aria-labelledby="ma-example-title">
    <div class="ma-example-mark" aria-hidden="true">↗</div>
    <div>
      <p class="eyebrow">{page.exampleEyebrow}</p>
      <h2 id="ma-example-title">{page.exampleTitle}</h2>
      <p>{page.exampleText}</p>
    </div>
  </section>

  <section class="wrap ma-start" aria-labelledby="ma-start-title">
    <div class="ma-section-head">
      <p class="eyebrow">{page.startEyebrow}</p>
      <h2 id="ma-start-title">{page.startTitle}</h2>
    </div>
    <div class="ma-start-grid">
      <div class="ma-start-card">
        <span class="ma-card-tag">01 / Desktop</span>
        <h3>{page.desktopTitle}</h3>
        <p>{page.desktopText}</p>
        <a href={downloadUrl}>{page.download} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="ma-start-card">
        <span class="ma-card-tag">02 / Cloud</span>
        <h3>{page.cloudTitle}</h3>
        <p>{page.cloudText}</p>
        <a href={accessUrl}>{page.requestAccess} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="wrap ma-final" aria-labelledby="ma-final-title">
    <h2 class="h-display" id="ma-final-title">{page.finalTitle}</h2>
    <p>{page.finalText}</p>
    <a class="btn btn-primary" href={siteUrl}>{page.explore} <span aria-hidden="true">↗</span></a>
  </section>
</main>
<Footer locale={locale} />

<style>
  .ma { padding: clamp(3.5rem, 8vw, 7rem) 0 5rem; }
  .ma-hero { max-width: 1120px; padding-bottom: clamp(4rem, 8vw, 7rem); }
  .ma-h1 { max-width: 13ch; margin: 1rem 0 1.5rem; font-size: clamp(3rem, 7vw, 6rem); line-height: 1.04; letter-spacing: -0.075em; }
  .ma-lead { max-width: 45rem; color: var(--color-text-secondary); font-size: clamp(1.08rem, 1.6vw, 1.3rem); line-height: 1.65; }
  .ma-actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2rem; }
  .ma-actions a, .ma-final a { gap: .6rem; }
  .ma-relation, .ma-capabilities, .ma-start { max-width: 1120px; margin-bottom: clamp(4.5rem, 9vw, 8rem); }
  .ma-section-head { max-width: 39rem; margin-bottom: 2rem; }
  .ma-section-head h2, .ma-example h2 { margin-top: .7rem; font-size: clamp(2rem, 4vw, 3.25rem); line-height: 1.12; letter-spacing: -.055em; }
  .ma-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border: 1px solid var(--color-border); border-radius: 1.25rem; overflow: hidden; }
  .ma-product { min-height: 16rem; display: flex; flex-direction: column; align-items: flex-start; padding: clamp(1.6rem, 3vw, 2.5rem); background: var(--color-surface); }
  .ma-product-many { border-left: 1px solid var(--color-border); background: var(--color-olive-muted); }
  .ma-product-index, .ma-card-tag, .ma-number { font-family: var(--font-mono); font-size: .75rem; letter-spacing: .08em; color: var(--color-text-secondary); }
  .ma-product-many .ma-product-index { color: var(--color-many-body); }
  .ma-product h3 { margin-top: auto; font-size: clamp(1.65rem, 3vw, 2.35rem); letter-spacing: -.045em; }
  .ma-product p { max-width: 29rem; margin-top: .5rem; color: var(--color-text-secondary); line-height: 1.6; }
  .ma-product-many h3 { color: var(--color-many-body); }
  .ma-account { margin-top: 1rem; color: var(--color-text-secondary); font-size: .93rem; }
  .ma-capability-list { list-style: none; border-top: 1px solid var(--color-border); }
  .ma-capability-list li { display: grid; grid-template-columns: 3.5rem minmax(13rem, .85fr) minmax(0, 1fr); gap: 1.4rem; align-items: baseline; padding: 1.6rem 0; border-bottom: 1px solid var(--color-border); }
  .ma-number { color: var(--color-many-body); }
  .ma-capability-list h3 { font-size: clamp(1.1rem, 1.6vw, 1.35rem); line-height: 1.3; letter-spacing: -.025em; }
  .ma-capability-list p { color: var(--color-text-secondary); line-height: 1.65; }
  .ma-example { max-width: 1120px; display: grid; grid-template-columns: minmax(4rem, .3fr) minmax(0, 1fr); gap: 2rem; padding: clamp(2rem, 5vw, 4rem); margin-bottom: clamp(4.5rem, 9vw, 8rem); border-radius: 1.5rem; color: var(--color-olive-ink); background: var(--color-many-body); }
  .ma-example .eyebrow, .ma-example p { color: var(--color-olive-ink); }
  .ma-example h2 { max-width: 17ch; }
  .ma-example p:last-child { max-width: 42rem; margin-top: 1.2rem; font-size: 1.08rem; line-height: 1.65; }
  .ma-example-mark { font-size: clamp(3rem, 7vw, 6rem); line-height: 1; }
  .ma-start-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .ma-start-card { display: flex; flex-direction: column; align-items: flex-start; min-height: 18rem; padding: clamp(1.5rem, 3vw, 2.4rem); border: 1px solid var(--color-border); border-radius: 1.25rem; background: var(--color-surface); }
  .ma-start-card h3 { margin-top: 2rem; font-size: 1.6rem; letter-spacing: -.04em; }
  .ma-start-card p { max-width: 29rem; margin: .6rem 0 1.7rem; color: var(--color-text-secondary); line-height: 1.6; }
  .ma-start-card a { margin-top: auto; color: var(--color-many-body); font-weight: 600; text-underline-offset: .25rem; }
  .ma-start-card a:hover { color: var(--color-white); }
  .ma-final { max-width: 1120px; padding-top: clamp(2.5rem, 5vw, 4rem); border-top: 1px solid var(--color-border); }
  .ma-final h2 { max-width: 15ch; font-size: clamp(2.3rem, 5vw, 4.5rem); line-height: 1.1; letter-spacing: -.06em; }
  .ma-final p { max-width: 35rem; margin: 1rem 0 1.8rem; color: var(--color-text-secondary); font-size: 1.1rem; }
  @media (max-width: 720px) {
    .ma { padding-top: 3rem; }
    .ma-h1 { font-size: clamp(2.8rem, 11vw, 4.5rem); }
    .ma-pair, .ma-start-grid { grid-template-columns: 1fr; }
    .ma-product { min-height: 12rem; }
    .ma-product-many { border-left: 0; border-top: 1px solid var(--color-border); }
    .ma-capability-list li { grid-template-columns: 2.5rem minmax(0, 1fr); gap: .5rem 1rem; }
    .ma-capability-list p { grid-column: 2; }
    .ma-example { grid-template-columns: 1fr; gap: .5rem; }
    .ma-example-mark { font-size: 3rem; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .ma-start-card { transition: border-color 180ms ease, transform 180ms ease; }
    .ma-start-card:hover { border-color: var(--color-many-stroke); transform: translateY(-3px); }
  }
</style>
