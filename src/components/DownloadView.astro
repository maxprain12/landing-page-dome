---
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import ReleaseStatus from './ReleaseStatus.astro';
import { changelogUrl, downloadUrl } from '../data/landing';
import { t, type Locale } from '../i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const page = t(locale).pages.download;
const groups = [
  { id: 'mac', label: 'macOS', icon: '/assets/os/apple.svg', cards: [{platform: 'mac', kind: 'dmg', arch: 'arm64', label: page.platforms.macArm, blurb: page.platformBlurbs.macArm}, {platform: 'mac', kind: 'dmg', arch: 'other', label: page.platforms.macIntel, blurb: page.platformBlurbs.macIntel}] },
  { id: 'win', label: 'Windows', icon: '/assets/os/windows.svg', cards: [{platform: 'win', kind: 'nsis', label: page.platforms.windows, blurb: page.platformBlurbs.windows}] },
  { id: 'linux', label: 'Linux', icon: '/assets/os/linux.svg', cards: [{platform: 'linux', kind: 'appimage', label: page.platforms.linuxAppImage, blurb: page.platformBlurbs.linuxAppImage}, {platform: 'linux', kind: 'flatpak', label: page.platforms.linuxFlatpak, blurb: page.platformBlurbs.linuxFlatpak}] },
];
---
<Nav locale={locale} esHref={downloadUrl('es')} enHref={downloadUrl('en')} />
<main id="main-content" class="dl" data-live-releases aria-busy="true">
  <div class="wrap dl-hero"><p class="eyebrow">{page.eyebrow}</p><h1 class="h-display dl-h1">{page.h1}</h1><p class="dl-lead">{page.lead}</p>
    <p class="dl-meta" data-release-ready hidden><span>{page.versionLabel} <span data-live-version></span></span><span aria-hidden="true">·</span><time data-live-date></time><span aria-hidden="true">·</span><a data-live-changelog-link href={changelogUrl(locale)}>{page.changelogLink}</a></p>
  </div>
  <ReleaseStatus locale={locale} kind="download" />
  <section class="wrap dl-stage" data-release-ready hidden aria-label={page.h1}>
    <div class="dl-tabs" role="tablist" aria-label={locale === 'es' ? 'Sistema operativo' : 'Operating system'}>{groups.map(group => <button class="dl-tab" type="button" role="tab" id={`tab-${group.id}`} aria-controls={`panel-${group.id}`} data-tab={group.id} aria-selected="false" tabindex="-1"><span class="os-icon" style={`--icon: url('${group.icon}')`}></span>{group.label}</button>)}</div>
    {groups.map(group => <article class="dl-panel" role="tabpanel" id={`panel-${group.id}`} aria-labelledby={`tab-${group.id}`} data-platform={group.id} data-cards={JSON.stringify(group.cards)} hidden>
      <span class="os-icon dl-os" style={`--icon: url('${group.icon}')`}></span><h2 data-download-title></h2><p class="dl-blurb" data-download-blurb></p>
      <a class="btn btn-primary dl-download" data-download rel="noopener">{page.downloadLabel}</a><p class="dl-size" data-size></p>
      <p class="dl-also" data-also data-also-label={page.alsoLabel} hidden></p>
      <details class="dl-details"><summary>{page.detailsSummary}</summary><p class="dl-sha"><span>{page.checksumLabel}</span><code data-sha></code></p><p class="dl-file" data-file></p></details>
    </article>)}
    <p class="dl-empty" data-download-empty hidden>{page.empty}</p>
  </section>
</main>
<Footer locale={locale} />
<script>
  import { startLiveReleases } from '../scripts/live-releases';
  void startLiveReleases();
</script>
<style>
  [hidden] { display: none !important; }
  .dl-also :global(a) { color: var(--color-text); text-decoration: underline; text-underline-offset: 3px; }
  .dl {
    padding: clamp(2.6rem, 6vw, 4.8rem) 0 4.4rem;
  }
  .dl-hero {
    max-width: 40rem;
    margin: 0 auto 2.4rem;
    text-align: center;
  }
  .dl-h1 {
    font-size: clamp(2.2rem, 5vw, 3.3rem);
    margin: 0.6rem 0 1rem;
  }
  .dl-lead {
    font-size: 1.12rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 0 1rem;
  }
  .dl-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem 0.65rem;
    margin: 0;
    font-size: 0.92rem;
    color: var(--color-ink-3);
  }
  .dl-meta a {
    color: var(--color-lavender-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .dl-stage {
    max-width: 36rem;
    margin-inline: auto;
  }
  .dl-tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem;
    margin-bottom: 1.6rem;
  }
  .dl-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 2.2rem;
    padding: 0 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text);
    font: inherit;
    cursor: pointer;
  }
  .os-icon {
    width: 0.95rem;
    height: 0.95rem;
    flex: 0 0 auto;
    background: currentColor;
    -webkit-mask: var(--icon) center / contain no-repeat;
    mask: var(--icon) center / contain no-repeat;
  }
  .dl-tab[aria-selected="true"] {
    background: var(--color-text);
    color: var(--color-bg);
    border-color: var(--color-text);
  }
  .dl-panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .dl-panel[hidden] {
    display: none !important;
  }
  .dl-panel h2 {
    margin: 0.35rem 0 0;
    font-size: 1.6rem;
  }
  .dl-download {
    margin-top: 0.35rem;
  }
  .dl-os {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--c-olive);
  }
  .dl-also {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.7rem;
    margin: 0;
    color: var(--color-ink-3);
    font-size: 0.9rem;
  }
  .dl-also a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .dl-blurb {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.92rem;
    line-height: 1.45;
  }
  .dl-size {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.92rem;
  }
  .dl-details {
    margin-top: 0.2rem;
  }
  .dl-details summary {
    cursor: pointer;
    color: var(--color-text-secondary);
    font-size: 0.86rem;
  }
  .dl-sha {
    margin: 0.75rem 0 0.4rem;
    font-size: 0.82rem;
    color: var(--color-text-secondary);
    display: grid;
    gap: 0.35rem;
  }
  .dl-sha code {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.45;
    word-break: break-all;
    color: var(--c-olive);
  }
  .dl-file {
    margin: 0;
    font-size: 0.82rem;
    color: var(--color-ink-3);
    word-break: break-all;
  }
  .dl-empty {
    max-width: 36rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    align-items: center;
  }
  .dl-empty p {
    flex: 1 1 100%;
    margin: 0 0 0.4rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
  }
</style>
