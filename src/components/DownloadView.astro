---
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import { changelogUrl, downloadUrl } from "../data/landing";
import { localizePath, t, type Locale } from "../i18n";
import {
  formatSize,
  getLatest,
  pickInstaller,
  type ReleaseAsset,
} from "../lib/releases";

interface Props {
  locale: Locale;
}

type CardId = "mac-arm" | "mac-intel" | "win" | "linux-appimage" | "linux-flatpak";

interface DownloadCard {
  id: CardId;
  label: string;
  blurb: string;
  asset: ReleaseAsset | undefined;
}

const { locale } = Astro.props;
const copy = t(locale);
const page = copy.pages.download;
const contactHref = localizePath("/contact", locale);
const entry = await getLatest("latest");

const blurbs = page.platformBlurbs;
const cards: DownloadCard[] = entry
  ? [
      {
        id: "mac-arm",
        label: page.platforms.macArm,
        blurb: blurbs.macArm,
        asset: pickInstaller(entry, { platform: "mac", kind: "dmg", arch: "arm64" }),
      },
      {
        id: "mac-intel",
        label: page.platforms.macIntel,
        blurb: blurbs.macIntel,
        asset: pickInstaller(entry, { platform: "mac", kind: "dmg", arch: "other" }),
      },
      {
        id: "win",
        label: page.platforms.windows,
        blurb: blurbs.windows,
        asset: pickInstaller(entry, { platform: "win", kind: "nsis" }),
      },
      {
        id: "linux-appimage",
        label: page.platforms.linuxAppImage,
        blurb: blurbs.linuxAppImage,
        asset: pickInstaller(entry, { platform: "linux", kind: "appimage" }),
      },
      {
        id: "linux-flatpak",
        label: page.platforms.linuxFlatpak,
        blurb: blurbs.linuxFlatpak,
        asset: pickInstaller(entry, { platform: "linux", kind: "flatpak" }),
      },
    ]
  : [];

const hasAnyAsset = cards.some((card) => Boolean(card.asset));
const releasedLabel = entry
  ? new Date(entry.date).toLocaleDateString(locale === "es" ? "es-ES" : "en-US", {
      day: "numeric",
      month: "short",
      year: "numeric",
    })
  : "";
const changelogHref = changelogUrl(locale);
const logos: Record<CardId, string> = {
  "mac-arm": "/assets/os/apple.svg",
  "mac-intel": "/assets/os/apple.svg",
  win: "/assets/os/windows.svg",
  "linux-appimage": "/assets/os/appimage.svg",
  "linux-flatpak": "/assets/os/flatpak.svg",
};
---

<Nav locale={locale} esHref={downloadUrl("es")} enHref={downloadUrl("en")} />
<main id="main-content" class="dl">
  <div class="wrap dl-hero">
    <p class="eyebrow">{page.eyebrow}</p>
    <h1 class="h-display dl-h1">{page.h1}</h1>
    <p class="dl-lead">{page.lead}</p>
    {
      entry && hasAnyAsset ? (
        <p class="dl-meta">
          <span>
            {page.versionLabel} {entry.version}
          </span>
          <span aria-hidden="true">·</span>
          <time datetime={entry.date}>{releasedLabel}</time>
          <span aria-hidden="true">·</span>
          <a href={`${changelogHref}#v${entry.version}`}>{page.changelogLink}</a>
        </p>
      ) : null
    }
  </div>

  {
    entry && hasAnyAsset ? (
      <section class="wrap dl-stage" aria-label={page.h1}>
        <div>
          <div class="dl-tabs" role="tablist">
            {cards.filter((card) => card.asset).map((card) => (
              <button class="dl-tab" type="button" role="tab" data-tab={card.id} aria-selected="false">
                <img src={logos[card.id]} alt="" width="16" height="16" />
                {card.label}
              </button>
            ))}
          </div>
          {cards.map((card) =>
            card.asset ? (
              <article class="dl-panel" data-platform={card.id} hidden>
                <img class="dl-os" src={logos[card.id]} alt="" width="28" height="28" />
                <h2>{card.label}</h2>
                <p class="dl-blurb">{card.blurb}</p>
                <a class="btn btn-primary" href={card.asset.url} rel="noopener">
                  {page.downloadLabel}
                </a>
                <p class="dl-size">{formatSize(card.asset.size)}</p>
                <details class="dl-details">
                  <summary>{page.detailsSummary}</summary>
                  <p class="dl-sha">
                    <span>{page.checksumLabel}</span>
                    <code>{card.asset.sha512}</code>
                  </p>
                  <p class="dl-file">{card.asset.name}</p>
                </details>
              </article>
            ) : null,
          )}
        </div>
        <img class="dl-many" src="/assets/Many.svg" alt="" width="280" height="280" />
      </section>
    ) : (
      <section class="wrap dl-empty" aria-live="polite">
        <p>{page.empty}</p>
        <a class="btn btn-primary" href={contactHref}>
          {page.emptyContact}
        </a>
      </section>
    )
  }
</main>
<Footer locale={locale} />

<script>
  function detectPlatformKey(): string | null {
    const nav = globalThis.navigator;
    if (!nav) return null;
    const uaData = (nav as Navigator & { userAgentData?: { platform?: string } }).userAgentData;
    const raw =
      uaData?.platform ??
      // Fallback required: userAgentData is not universal yet.
      (nav as Navigator & { platform?: string }).platform ??
      "";
    const platform = String(raw).toLowerCase();
    if (platform.includes("win")) return "win";
    if (platform.includes("linux")) return "linux-appimage";
    if (
      platform.includes("mac") ||
      platform.includes("darwin") ||
      platform.includes("iphone") ||
      platform.includes("ipad")
    ) {
      return "mac-arm";
    }
    return null;
  }

  const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-tab]")];
  const panels = [...document.querySelectorAll<HTMLElement>("[data-platform]")];
  function show(id: string) {
    for (const tab of tabs) {
      const on = tab.dataset.tab === id;
      tab.setAttribute("aria-selected", on ? "true" : "false");
    }
    for (const panel of panels) {
      panel.hidden = panel.dataset.platform !== id;
    }
  }
  const first = detectPlatformKey() ?? tabs[0]?.dataset.tab ?? null;
  if (first) show(first);
  for (const tab of tabs) {
    tab.addEventListener("click", () => {
      if (tab.dataset.tab) show(tab.dataset.tab);
    });
  }
</script>

<style>
  .dl {
    padding: clamp(2.6rem, 6vw, 4.8rem) 0 4.4rem;
  }
  .dl-hero {
    max-width: 44rem;
    margin-bottom: 2.2rem;
  }
  .dl-h1 {
    font-size: clamp(2.2rem, 5vw, 3.3rem);
    margin: 0.6rem 0 1rem;
  }
  .dl-lead {
    font-size: 1.12rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 0 1rem;
  }
  .dl-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.65rem;
    margin: 0;
    font-size: 0.92rem;
    color: var(--color-ink-3);
  }
  .dl-meta a {
    color: var(--color-lavender-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .dl-stage {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(12rem, 0.85fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }
  .dl-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1.4rem;
  }
  .dl-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 2.2rem;
    padding: 0 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-secondary);
    font: inherit;
    cursor: pointer;
  }
  .dl-tab img {
    width: 0.95rem;
    height: 0.95rem;
  }
  .dl-tab[aria-selected="true"] {
    background: var(--color-text);
    color: var(--color-bg);
    border-color: var(--color-text);
  }
  .dl-panel h2 {
    margin: 0.8rem 0 0.4rem;
    font-size: 1.6rem;
  }
  .dl-os {
    width: 1.6rem;
    height: 1.6rem;
  }
  .dl-many {
    width: min(100%, 18rem);
    height: auto;
    justify-self: center;
  }
  .dl-card {
    padding: 1.35rem 1.4rem 1.45rem;
    border-radius: 20px;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-surface) 80%, transparent);
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .dl-card.is-recommended {
    border-color: color-mix(in srgb, var(--c-olive) 42%, var(--color-border));
    background: color-mix(in srgb, var(--color-olive-muted) 55%, var(--color-surface));
  }
  .dl-rec {
    margin: 0;
    display: inline-flex;
    align-self: flex-start;
    height: 1.55rem;
    align-items: center;
    padding: 0 0.65rem;
    border-radius: 999px;
    background: var(--c-olive);
    color: var(--color-olive-ink);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .dl-mark {
    width: 2.4rem;
    height: 2.4rem;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: color-mix(in srgb, var(--c-olive) 16%, var(--color-surface));
    color: var(--c-olive);
  }
  .dl-mark svg {
    width: 1.2rem;
    height: 1.2rem;
    fill: currentColor;
  }
  .dl-card h2 {
    font-size: 1.2rem;
    margin: 0;
  }
  .dl-blurb {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.92rem;
    line-height: 1.45;
  }
  .dl-size {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.92rem;
  }
  .dl-card .btn {
    align-self: flex-start;
  }
  .dl-details {
    margin-top: 0.2rem;
  }
  .dl-details summary {
    cursor: pointer;
    color: var(--color-text-secondary);
    font-size: 0.86rem;
  }
  .dl-sha {
    margin: 0.75rem 0 0.4rem;
    font-size: 0.82rem;
    color: var(--color-text-secondary);
    display: grid;
    gap: 0.35rem;
  }
  .dl-sha code {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.45;
    word-break: break-all;
    color: var(--c-olive);
  }
  .dl-file {
    margin: 0;
    font-size: 0.82rem;
    color: var(--color-ink-3);
    word-break: break-all;
  }
  .dl-empty {
    max-width: 36rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    align-items: center;
  }
  .dl-empty p {
    flex: 1 1 100%;
    margin: 0 0 0.4rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
  }
  @media (max-width: 860px) {
    .dl-stage {
      grid-template-columns: 1fr;
    }
    .dl-many {
      order: -1;
    }
  }
</style>
