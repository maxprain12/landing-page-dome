---
import { localeFromPath, t, type Locale } from "../i18n";
import HowScene from "./HowScene.astro";

interface Props {
  locale?: Locale;
}

type SceneId = "library" | "many" | "study" | "people" | "calendar" | "agents";

const scenes: SceneId[] = ["library", "many", "study", "people", "calendar", "agents"];

function isScene(id: string): id is SceneId {
  return (scenes as readonly string[]).includes(id);
}

const locale: Locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const copy = t(locale);
const prevLabel = locale === "en" ? "Previous" : "Anterior";
const nextLabel = locale === "en" ? "Next" : "Siguiente";
---

<section class="how section" id="como-funciona">
  <div class="how-head">
    <h2 class="h-display how-h2">{copy.how.h2}</h2>
    <div class="how-nav" data-how-nav>
      <button type="button" class="how-arrow" data-how-prev aria-label={prevLabel}>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M11.25 4.5 6.75 9l4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
      <button type="button" class="how-arrow" data-how-next aria-label={nextLabel}>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M6.75 4.5 11.25 9l-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
  </div>
  <div class="how-viewport">
    <div class="how-track" data-how-track>
      {
        copy.how.features.map((feature) => (
          <article class="how-card" data-how-card={feature.id}>
            <div class="how-copy">
              <h3>{feature.title}</h3>
              <p>{feature.text}</p>
            </div>
            <div class="how-visual">
              {isScene(feature.id) ? <HowScene id={feature.id} locale={locale} /> : null}
              <div class="how-prompt">
                <span>{feature.prompt}</span>
                <span class="how-prompt-send" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                    <path d="M7 11.5V2.5M7 2.5 3.5 6M7 2.5 10.5 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </span>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .how {
    background: var(--color-bg);
    overflow: hidden;
  }
  .how-head {
    width: min(1180px, calc(100% - 2.5rem));
    margin: 0 auto 1.6rem;
  }
  .how-h2 {
    margin: 0 auto 1.25rem;
    text-align: center;
    max-width: 15em;
    font-size: clamp(2.15rem, 4.8vw, 3.25rem);
    letter-spacing: -0.048em;
    line-height: 1.08;
    text-wrap: balance;
  }
  .how-nav {
    display: flex;
    justify-content: center;
    gap: 0.35rem;
  }
  .how-arrow {
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    border: 0;
    background: transparent;
    color: #a1a1aa;
    cursor: pointer;
  }
  .how-arrow:hover:not(:disabled) {
    color: #fafafa;
  }
  .how-arrow:disabled {
    opacity: 0.28;
    cursor: default;
  }
  .how-viewport {
    width: min(1180px, calc(100% - 2.5rem));
    margin-inline: auto;
    overflow: hidden;
  }
  .how-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 19.25rem;
    gap: 0.85rem;
    overflow-x: auto;
    scrollbar-width: none;
    touch-action: pan-x;
    cursor: grab;
    overscroll-behavior-x: contain;
  }
  .how-track.is-dragging {
    cursor: grabbing;
  }
  .how-track::-webkit-scrollbar {
    display: none;
  }
  .how-card {
    display: flex;
    flex-direction: column;
    min-height: 36.5rem;
    overflow: hidden;
    border-radius: 24px;
    background: #f4f4f4;
    color: #18181b;
  }
  .how-copy {
    padding: 1.45rem 1.3rem 0.55rem;
    z-index: 2;
  }
  .how-copy h3 {
    margin: 0 0 0.45rem;
    font-size: 1.22rem;
    letter-spacing: -0.03em;
    font-weight: 600;
    color: #18181b;
  }
  .how-copy p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.45;
    color: #52525b;
  }
  .how-visual {
    position: relative;
    flex: 1 1 auto;
    min-height: 26rem;
    overflow: hidden;
  }
  .how-prompt {
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 0.85rem;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.68rem 0.65rem 0.68rem 0.9rem;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 10px 28px rgba(24, 24, 27, 0.16);
    font-size: 0.74rem;
    line-height: 1.3;
    color: #3f3f46;
  }
  .how-prompt span:first-child {
    flex: 1 1 auto;
    min-width: 0;
  }
  .how-prompt-send {
    flex: 0 0 auto;
    width: 1.65rem;
    height: 1.65rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: #18181b;
    color: #fafafa;
  }
  @media (max-width: 980px) {
    .how-track {
      grid-auto-columns: 18.5rem;
    }
    .how-card {
      min-height: 38rem;
    }
  }
  @media (max-width: 640px) {
    .how-head,
    .how-viewport {
      width: calc(100% - 1.5rem);
    }
    .how-h2 {
      max-width: 14ch;
      font-size: clamp(1.85rem, 8vw, 2.35rem);
    }
    .how-track {
      grid-auto-columns: min(20.5rem, 82vw);
    }
    .how-card {
      min-height: 32rem;
    }
    .how-prompt {
      font-size: 0.7rem;
    }
  }
</style>
