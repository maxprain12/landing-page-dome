---
import { finalCta } from "../data/landing";
---

<section class="fc" id="download">
  <div class="wrap fc-in" data-reveal>
    <img class="fc-mascot" src={finalCta.mascot} alt="" width="96" height="96" />
    <h2 class="h-display fc-h2">{finalCta.title}</h2>
    <p class="fc-sub">{finalCta.subtitle}</p>
    <div class="fc-row">
      <a class="btn fc-primary" href={finalCta.primary.href} target="_blank" rel="noopener">
        {finalCta.primary.label}
      </a>
      <a class="btn fc-ghost" href={finalCta.secondary.href} target="_blank" rel="noopener">
        {finalCta.secondary.label}
      </a>
    </div>
  </div>
</section>

<style>
  .fc {
    background:
      radial-gradient(60% 90% at 50% 0%, #6b7444 0%, transparent 60%),
      var(--color-accent);
    color: #fff;
    text-align: center;
  }
  .fc-in {
    padding: clamp(3.5rem, 7vw, 5.5rem) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .fc-mascot {
    width: 96px;
    height: 96px;
    margin-bottom: 0.6rem;
    filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.2));
  }
  .fc-h2 {
    color: #fff;
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    margin: 0 0 0.6rem;
  }
  .fc-sub {
    font-size: 1.05rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.85);
    max-width: 34rem;
    margin: 0 0 1.8rem;
  }
  .fc-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    justify-content: center;
  }
  .fc-primary {
    background: #fff;
    color: var(--color-accent);
  }
  .fc-primary:hover {
    transform: translateY(-2px);
  }
  .fc-ghost {
    background: transparent;
    color: #fff;
    border-color: rgba(255, 255, 255, 0.6);
  }
  .fc-ghost:hover {
    background: rgba(255, 255, 255, 0.12);
  }
</style>
