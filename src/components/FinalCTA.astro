---
import { downloadUrl } from "../data/landing";
import { localeFromPath, t, type Locale } from "../i18n";

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const copy = t(locale);
---

<section class="fc section" id="download">
  <div class="wrap">
    <div class="fc-band" data-reveal>
      <div class="fc-copy">
        <h2 class="h-display fc-h2">{copy.finalCta.h2}</h2>
        <p class="fc-sub">{copy.finalCta.lead}</p>
      </div>
      <a class="btn btn-primary fc-btn" href={downloadUrl(locale)}>
        {copy.finalCta.primary}
      </a>
    </div>
  </div>
</section>

<style>
  .fc {
    background: var(--color-bg);
    padding-top: 1rem;
  }
  .fc-band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 24px;
    padding: clamp(2rem, 5vw, 3.1rem) clamp(1.6rem, 4.5vw, 2.6rem);
  }
  .fc-copy {
    max-width: 38rem;
  }
  .fc-btn {
    font-size: 1.12rem;
    padding: 1.05rem 1.85rem;
    min-height: 3.15rem;
    flex: 0 0 auto;
  }
  .fc-h2 {
    color: #fafafa;
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    margin: 0 0 0.55rem;
  }
  .fc-sub {
    font-size: 1rem;
    line-height: 1.55;
    color: #a1a1aa;
    margin: 0;
  }
  @media (max-width: 700px) {
    .fc-band {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
