---
import { brand, links } from "../data/landing";
import { accountUrl, navDirectLinks, navMenus } from "../data/nav";
import { alternatePath, localeFromPath, localeHome, t, type Locale } from "../i18n";
import DomeIcon from "./icons/DomeIcon.astro";

interface Props {
  locale?: Locale;
  esHref?: string;
  enHref?: string;
}

const locale: Locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const copy = t(locale);
const home = localeHome(locale);
const esHref = Astro.props.esHref ?? alternatePath(Astro.url.pathname, "es");
const enHref = Astro.props.enHref ?? alternatePath(Astro.url.pathname, "en");
const loginHref = accountUrl();
const menus = navMenus(locale, copy);
const directLinks = navDirectLinks(locale, copy);
---

<header class="nav">
  <div class="nav-shell" data-nav-shell>
    <a href={home} class="nav-brand" aria-label={`${brand.name} home`}>
      <img src={brand.logo} alt="" height="22" width="22" />
      <span class="nav-brand-txt">{brand.name}</span>
    </a>

    <nav class="nav-links" aria-label={copy.nav.main}>
      {
        menus.map((menu) => (
          <div class="nav-drop" data-nav-drop>
            <button
              class="nav-drop-btn"
              type="button"
              data-nav-trigger
              aria-expanded="false"
              aria-haspopup="true"
              aria-controls={`nav-menu-${menu.id}`}
            >
              <span>{menu.label}</span>
              <DomeIcon name="chevron" size={14} />
            </button>
            <div class="nav-mega" id={`nav-menu-${menu.id}`} data-nav-panel hidden>
              {
                menu.columns.map((column) => (
                  <div class="nav-col">
                    <p class="nav-colh">{column.heading}</p>
                    <ul class="nav-col-list" role="list">
                      {column.items.map((item) => (
                        <li>
                          <a
                            href={item.href}
                            target={item.external ? "_blank" : undefined}
                            rel={item.external ? "noopener" : undefined}
                          >
                            <span class="nav-item-label">{item.label}</span>
                            {item.hint ? <span class="nav-item-hint">{item.hint}</span> : null}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))
              }
            </div>
          </div>
        ))
      }
      {
        directLinks.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))
      }
    </nav>

    <div class="nav-actions">
      <div class="nav-lang" role="group" aria-label={copy.nav.langLabel}>
        <a
          class:list={["nav-lang-btn", locale === "es" && "is-on"]}
          href={esHref}
          hreflang="es"
          data-set-locale="es"
          aria-current={locale === "es" ? "true" : undefined}>{copy.nav.langEs}</a
        >
        <a
          class:list={["nav-lang-btn", locale === "en" && "is-on"]}
          href={enHref}
          hreflang="en"
          data-set-locale="en"
          aria-current={locale === "en" ? "true" : undefined}>{copy.nav.langEn}</a
        >
      </div>
      <a class="nav-login" href={loginHref}>{copy.nav.login}</a>
      <a class="nav-cta" href={links.releases} target="_blank" rel="noopener">
        {copy.nav.download}
      </a>
      <button
        class="nav-burger"
        type="button"
        data-nav-toggle
        data-label-open={copy.nav.menu}
        data-label-close={copy.nav.close}
        aria-expanded="false"
        aria-controls="nav-panel"
        aria-label={copy.nav.menu}
      >
        <span class="nav-burger-open"><DomeIcon name="menu" size={18} /></span>
        <span class="nav-burger-close"><DomeIcon name="close" size={18} /></span>
      </button>
    </div>

    <nav class="nav-panel" id="nav-panel" aria-label={copy.nav.main}>
      {
        menus.map((menu) => (
          <details class="nav-acc">
            <summary>
              <span>{menu.label}</span>
              <span class="nav-acc-chevron" aria-hidden="true">
                <DomeIcon name="chevron" size={16} />
              </span>
            </summary>
            {menu.columns.map((column) => (
              <div class="nav-acc-col">
                <p class="nav-colh">{column.heading}</p>
                {column.items.map((item) => (
                  <a
                    href={item.href}
                    target={item.external ? "_blank" : undefined}
                    rel={item.external ? "noopener" : undefined}
                  >
                    {item.label}
                  </a>
                ))}
              </div>
            ))}
          </details>
        ))
      }
      {
        directLinks.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))
      }
      <a href={loginHref}>{copy.nav.login}</a>
      <div class="nav-lang nav-panel-lang" role="group" aria-label={copy.nav.langLabel}>
        <a
          class:list={["nav-lang-btn", locale === "es" && "is-on"]}
          href={esHref}
          hreflang="es"
          data-set-locale="es"
          aria-current={locale === "es" ? "true" : undefined}>{copy.nav.langEs}</a
        >
        <a
          class:list={["nav-lang-btn", locale === "en" && "is-on"]}
          href={enHref}
          hreflang="en"
          data-set-locale="en"
          aria-current={locale === "en" ? "true" : undefined}>{copy.nav.langEn}</a
        >
      </div>
    </nav>
  </div>
</header>

<script>
  const shells = document.querySelectorAll<HTMLElement>("[data-nav-shell]");
  for (const shell of shells) {
    const toggle = shell.querySelector<HTMLButtonElement>("[data-nav-toggle]");
    const drops = shell.querySelectorAll<HTMLElement>("[data-nav-drop]");

    const closeMobile = () => {
      if (!toggle) return;
      shell.classList.remove("is-open");
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", toggle.dataset.labelOpen || "Menu");
    };

    const closeDrops = (except?: HTMLElement) => {
      drops.forEach((drop) => {
        if (drop === except) return;
        drop.classList.remove("is-open");
        const trigger = drop.querySelector<HTMLButtonElement>("[data-nav-trigger]");
        const panel = drop.querySelector<HTMLElement>("[data-nav-panel]");
        trigger?.setAttribute("aria-expanded", "false");
        if (panel) panel.hidden = true;
      });
    };

    if (toggle) {
      toggle.addEventListener("click", () => {
        const open = shell.classList.toggle("is-open");
        toggle.setAttribute("aria-expanded", open ? "true" : "false");
        toggle.setAttribute(
          "aria-label",
          open ? toggle.dataset.labelClose || "Close" : toggle.dataset.labelOpen || "Menu",
        );
        if (open) closeDrops();
      });
    }

    shell.querySelectorAll<HTMLDetailsElement>(".nav-acc").forEach((item) => {
      item.addEventListener("toggle", () => {
        if (!item.open) return;
        shell.querySelectorAll<HTMLDetailsElement>(".nav-acc").forEach((other) => {
          if (other !== item) other.open = false;
        });
      });
    });

    drops.forEach((drop) => {
      const trigger = drop.querySelector<HTMLButtonElement>("[data-nav-trigger]");
      const panel = drop.querySelector<HTMLElement>("[data-nav-panel]");
      if (!trigger || !panel) return;
      trigger.addEventListener("click", () => {
        const open = !drop.classList.contains("is-open");
        closeDrops(open ? drop : undefined);
        drop.classList.toggle("is-open", open);
        trigger.setAttribute("aria-expanded", String(open));
        panel.hidden = !open;
      });
    });

    shell.querySelectorAll(".nav-panel a, .nav-mega a").forEach((link) => {
      link.addEventListener("click", () => {
        closeMobile();
        closeDrops();
      });
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeMobile();
        closeDrops();
      }
    });

    document.addEventListener("click", (event) => {
      if (!shell.contains(event.target as Node)) {
        closeMobile();
        closeDrops();
      }
    });
  }

  document.querySelectorAll<HTMLAnchorElement>("[data-set-locale]").forEach((link) => {
    link.addEventListener("click", () => {
      const next = link.dataset.setLocale;
      if (next === "es" || next === "en") {
        try {
          localStorage.setItem("dome-locale", next);
        } catch {
          /* ignore quota / private mode */
        }
      }
    });
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 80;
    display: flex;
    justify-content: center;
    padding: 0.85rem 1.1rem 0.45rem;
    background: transparent;
    pointer-events: none;
  }
  .nav-shell {
    pointer-events: auto;
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.7rem;
    width: min(1180px, 100%);
    padding: 0.4rem 0.4rem 0.4rem 0.95rem;
    background: color-mix(in srgb, var(--color-zinc-750) 92%, transparent);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    box-shadow:
      0 10px 40px color-mix(in srgb, var(--color-black) 42%, transparent),
      inset 0 1px 0 color-mix(in srgb, var(--color-white) 6%, transparent);
    backdrop-filter: blur(22px) saturate(1.35);
    -webkit-backdrop-filter: blur(22px) saturate(1.35);
  }
  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }
  .nav-brand img {
    height: 22px;
    width: 22px;
    object-fit: contain;
  }
  .nav-brand-txt {
    font-weight: 650;
    font-size: 0.98rem;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-text);
  }
  .nav-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.1rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-secondary);
  }
  .nav-links > a,
  .nav-drop-btn {
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    color: inherit;
    background: transparent;
    border: 0;
    font: inherit;
    cursor: pointer;
  }
  .nav-drop-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
  }
  .nav-links > a:hover,
  .nav-drop-btn:hover,
  .nav-drop.is-open .nav-drop-btn {
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-white) 5%, transparent);
  }
  .nav-drop {
    position: relative;
  }
  .nav-mega {
    position: absolute;
    top: calc(100% + 0.85rem);
    left: 50%;
    translate: -50% 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(13rem, 1fr));
    gap: 1.4rem 2rem;
    min-width: 34rem;
    padding: 1.15rem 1.25rem 1.2rem;
    background: color-mix(in srgb, var(--color-zinc-850) 96%, transparent);
    border: 1px solid var(--color-border);
    border-radius: 22px;
    box-shadow: 0 18px 50px color-mix(in srgb, var(--color-black) 45%, transparent);
    backdrop-filter: blur(22px);
  }
  .nav-mega[hidden] {
    display: none;
  }
  .nav-colh {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    margin: 0 0 0.7rem;
  }
  .nav-col-list {
    list-style: none;
  }
  .nav-col-list a {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    padding: 0.55rem 0.65rem;
    border-radius: 12px;
    color: var(--color-text);
  }
  .nav-col-list a:hover {
    background: color-mix(in srgb, var(--color-white) 5%, transparent);
  }
  .nav-item-label {
    font-weight: 600;
    font-size: 0.92rem;
  }
  .nav-item-hint {
    font-size: 0.78rem;
    color: var(--color-text-secondary);
    font-weight: 450;
  }
  .nav-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.4rem;
  }
  .nav-lang {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: 2px;
    padding: 3px;
    overflow: hidden;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-white) 5%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-white) 6%, transparent);
  }
  .nav-lang-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.05rem;
    height: 1.85rem;
    padding: 0 0.55rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    color: var(--color-text-secondary);
  }
  .nav-lang-btn:hover {
    color: var(--color-text);
  }
  .nav-lang-btn.is-on {
    background: color-mix(in srgb, var(--color-white) 92%, transparent);
    color: var(--color-bg);
  }
  .nav-login {
    padding: 0.4rem 0.65rem;
    border-radius: 999px;
    color: var(--color-text-secondary);
    font-size: 0.86rem;
    font-weight: 550;
  }
  .nav-login:hover {
    color: var(--color-text);
  }
  .nav-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.35rem;
    padding: 0 1.05rem;
    border-radius: 999px;
    background: var(--color-text);
    color: var(--color-bg);
    font-size: 0.84rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .nav-cta:hover {
    background: var(--color-accent-hover);
  }
  .nav-burger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-white) 4%, transparent);
    color: var(--color-text);
    cursor: pointer;
  }
  .nav-burger-close {
    display: none;
  }
  .nav-shell.is-open .nav-burger-open {
    display: none;
  }
  .nav-shell.is-open .nav-burger-close {
    display: block;
  }
  .nav-panel {
    display: none;
  }
  @media (max-width: 1080px) {
    .nav-login {
      display: none;
    }
  }
  @media (max-width: 960px) {
    .nav-shell {
      grid-template-columns: 1fr auto;
    }
    .nav-links,
    .nav-actions > .nav-lang {
      display: none;
    }
    .nav-burger {
      display: inline-flex;
    }
    .nav-panel {
      display: none;
      position: absolute;
      top: calc(100% + 0.55rem);
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0.2rem;
      max-height: min(74vh, 36rem);
      overflow: auto;
      padding: 0.65rem 0.65rem 0.75rem;
      background: color-mix(in srgb, var(--color-zinc-875) 94%, transparent);
      border: 1px solid var(--color-border);
      border-radius: 22px;
      box-shadow: 0 18px 50px color-mix(in srgb, var(--color-black) 45%, transparent);
      backdrop-filter: blur(22px);
    }
    .nav-shell.is-open .nav-panel {
      display: flex;
    }
    .nav-panel > a,
    .nav-acc-col a,
    .nav-acc summary {
      display: flex;
      align-items: center;
      width: 100%;
      padding: 0.75rem 0.85rem;
      border-radius: 12px;
      color: var(--color-zinc-100);
      font-weight: 500;
    }
    .nav-panel > a:hover,
    .nav-acc-col a:hover,
    .nav-acc summary:hover {
      background: color-mix(in srgb, var(--color-white) 5%, transparent);
      color: var(--color-text);
    }
    .nav-acc {
      border-radius: 12px;
    }
    .nav-acc summary {
      justify-content: space-between;
      gap: 0.75rem;
      cursor: pointer;
      list-style: none;
      font-weight: 600;
    }
    .nav-acc summary::marker,
    .nav-acc summary::-webkit-details-marker {
      display: none;
      content: "";
    }
    .nav-acc-chevron {
      display: inline-flex;
      color: var(--color-text-secondary);
      transition: transform 0.18s ease;
    }
    .nav-acc[open] .nav-acc-chevron {
      transform: rotate(180deg);
    }
    .nav-acc-col {
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
      padding: 0.1rem 0.25rem 0.55rem;
    }
    .nav-acc-col .nav-colh {
      margin: 0.45rem 0.6rem 0.15rem;
    }
    .nav-panel-lang {
      display: flex;
      align-self: stretch;
      width: calc(100% - 0.4rem);
      margin: 0.45rem 0.2rem 0.1rem;
      padding: 4px;
      border-top: 0;
    }
    .nav-panel-lang .nav-lang-btn {
      flex: 1;
      height: 2.1rem;
    }
    .nav-cta {
      height: 2.2rem;
      padding: 0 0.9rem;
      font-size: 0.8rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-acc-chevron {
      transition: none;
    }
  }
</style>
