---
import { brand, links } from "../data/landing";
import { alternatePath, localeFromPath, localeHome, t, type Locale } from "../i18n";
import DomeIcon from "./icons/DomeIcon.astro";

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const copy = t(locale);
const home = localeHome(locale);
const hash = (id: string) => `${home === "/" ? "" : home.replace(/\/$/, "")}${id}`;
const esHref = alternatePath(Astro.url.pathname, "es");
const enHref = alternatePath(Astro.url.pathname, "en");

const navItems = [
  { href: hash("#como-funciona"), label: copy.nav.how },
  { href: hash("#ediciones"), label: copy.nav.editions },
  { href: hash("#confianza"), label: copy.nav.trust },
  { href: hash("#faq"), label: copy.nav.faq },
];
---

<header class="nav">
  <div class="nav-shell" data-nav-shell>
    <a href={home} class="nav-brand" aria-label={`${brand.name} home`}>
      <img src={brand.logo} alt="" height="22" width="22" />
      <span class="nav-brand-txt">{brand.name}</span>
    </a>

    <nav class="nav-links" aria-label="Main">
      {navItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>

    <div class="nav-actions">
      <div class="nav-lang" role="group" aria-label={copy.nav.langLabel}>
        <a
          class:list={["nav-lang-btn", locale === "es" && "is-on"]}
          href={esHref}
          hreflang="es"
          data-set-locale="es"
          aria-current={locale === "es" ? "true" : undefined}>{copy.nav.langEs}</a
        >
        <a
          class:list={["nav-lang-btn", locale === "en" && "is-on"]}
          href={enHref}
          hreflang="en"
          data-set-locale="en"
          aria-current={locale === "en" ? "true" : undefined}>{copy.nav.langEn}</a
        >
      </div>
      <a class="nav-cta" href={links.releases} target="_blank" rel="noopener">
        {copy.nav.download}
      </a>
      <button
        class="nav-burger"
        type="button"
        data-nav-toggle
        data-label-open={copy.nav.menu}
        data-label-close={copy.nav.close}
        aria-expanded="false"
        aria-controls="nav-panel"
        aria-label={copy.nav.menu}
      >
        <span class="nav-burger-open"><DomeIcon name="menu" size={18} /></span>
        <span class="nav-burger-close"><DomeIcon name="close" size={18} /></span>
      </button>
    </div>

    <nav class="nav-panel" id="nav-panel" aria-label="Main">
      {navItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
      <div class="nav-panel-lang" role="group" aria-label={copy.nav.langLabel}>
        <a
          class:list={["nav-lang-btn", locale === "es" && "is-on"]}
          href={esHref}
          hreflang="es"
          data-set-locale="es"
          aria-current={locale === "es" ? "true" : undefined}>{copy.nav.langEs}</a
        >
        <a
          class:list={["nav-lang-btn", locale === "en" && "is-on"]}
          href={enHref}
          hreflang="en"
          data-set-locale="en"
          aria-current={locale === "en" ? "true" : undefined}>{copy.nav.langEn}</a
        >
      </div>
    </nav>
  </div>
</header>

<script>
  const shells = document.querySelectorAll<HTMLElement>("[data-nav-shell]");
  for (const shell of shells) {
    const toggle = shell.querySelector<HTMLButtonElement>("[data-nav-toggle]");
    if (!toggle) continue;
    const close = () => {
      shell.classList.remove("is-open");
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", toggle.dataset.labelOpen || "Menu");
    };
    toggle.addEventListener("click", () => {
      const open = shell.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      toggle.setAttribute(
        "aria-label",
        open ? toggle.dataset.labelClose || "Close" : toggle.dataset.labelOpen || "Menu",
      );
    });
    shell.querySelectorAll(".nav-panel a").forEach((link) => {
      link.addEventListener("click", close);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") close();
    });
  }

  document.querySelectorAll<HTMLAnchorElement>("[data-set-locale]").forEach((link) => {
    link.addEventListener("click", () => {
      const next = link.dataset.setLocale;
      if (next === "es" || next === "en") {
        try {
          localStorage.setItem("dome-locale", next);
        } catch {
          /* ignore quota / private mode */
        }
      }
    });
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 80;
    display: flex;
    justify-content: center;
    padding: 0.85rem 1.1rem 0.45rem;
    background: transparent;
    pointer-events: none;
  }
  .nav-shell {
    pointer-events: auto;
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    width: min(1080px, 100%);
    padding: 0.4rem 0.4rem 0.4rem 0.95rem;
    background: rgba(28, 28, 32, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    box-shadow:
      0 10px 40px rgba(0, 0, 0, 0.42),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(22px) saturate(1.35);
    -webkit-backdrop-filter: blur(22px) saturate(1.35);
  }
  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }
  .nav-brand img {
    height: 22px;
    width: 22px;
    object-fit: contain;
  }
  .nav-brand-txt {
    font-weight: 650;
    font-size: 0.98rem;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-text);
  }
  .nav-links {
    display: flex;
    justify-content: center;
    gap: 0.15rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-secondary);
  }
  .nav-links a {
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
  }
  .nav-links a:hover {
    color: var(--color-text);
    background: rgba(255, 255, 255, 0.05);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.45rem;
  }
  .nav-lang {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  .nav-lang-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.05rem;
    height: 1.85rem;
    padding: 0 0.45rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    color: var(--color-text-secondary);
  }
  .nav-lang-btn:hover {
    color: var(--color-text);
  }
  .nav-lang-btn.is-on {
    background: rgba(255, 255, 255, 0.92);
    color: var(--color-bg);
  }
  .nav-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.35rem;
    padding: 0 1.05rem;
    border-radius: 999px;
    background: var(--color-text);
    color: var(--color-bg);
    font-size: 0.84rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .nav-cta:hover {
    background: var(--color-accent-hover);
  }
  .nav-burger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    color: var(--color-text);
    cursor: pointer;
  }
  .nav-burger-close {
    display: none;
  }
  .nav-shell.is-open .nav-burger-open {
    display: none;
  }
  .nav-shell.is-open .nav-burger-close {
    display: block;
  }
  .nav-panel {
    display: none;
  }
  @media (max-width: 860px) {
    .nav-shell {
      grid-template-columns: 1fr auto;
    }
    .nav-links,
    .nav-lang {
      display: none;
    }
    .nav-burger {
      display: inline-flex;
    }
    .nav-panel {
      display: none;
      position: absolute;
      top: calc(100% + 0.55rem);
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0.15rem;
      padding: 0.7rem;
      background: rgba(18, 18, 20, 0.94);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 22px;
      box-shadow: 0 18px 50px rgba(0, 0, 0, 0.45);
      backdrop-filter: blur(22px);
    }
    .nav-shell.is-open .nav-panel {
      display: flex;
    }
    .nav-panel a {
      padding: 0.75rem 0.85rem;
      border-radius: 12px;
      color: var(--color-zinc-100);
      font-weight: 500;
    }
    .nav-panel a:hover {
      background: rgba(255, 255, 255, 0.05);
      color: var(--color-text);
    }
    .nav-panel-lang {
      display: flex;
      gap: 0.4rem;
      padding: 0.55rem 0.35rem 0.2rem;
      margin-top: 0.25rem;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }
    .nav-cta {
      height: 2.2rem;
      padding: 0 0.9rem;
      font-size: 0.8rem;
    }
  }
</style>
