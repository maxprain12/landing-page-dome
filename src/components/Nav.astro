---
import { nav } from "../data/landing";
---

<header class="nav">
  <div class="wrap nav-in">
    <a href="/" class="nav-brand" aria-label={`${nav.brand} home`}>
      <img src={nav.logo} alt="" height="32" width="32" />
      <span class="nav-brand-txt">{nav.brand}</span>
    </a>
    <nav class="nav-links" aria-label="Main">
      {nav.links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <a class="btn btn-primary nav-cta" href={nav.cta.href} target="_blank" rel="noopener">
      {nav.cta.label}
    </a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(251, 253, 246, 0.8);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
  }
  .nav-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.85rem 0;
  }
  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
  }
  .nav-brand img {
    height: 32px;
    width: auto;
  }
  .nav-brand-txt {
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--color-text);
  }
  .nav-links {
    display: flex;
    gap: 1.8rem;
    font-size: 0.92rem;
    color: var(--color-text-secondary);
  }
  .nav-links a {
    text-decoration: none;
    color: inherit;
    transition: color 0.15s ease;
  }
  .nav-links a:hover {
    color: var(--color-accent);
  }
  .nav-cta {
    padding: 0.6rem 1.2rem;
    font-size: 0.9rem;
  }
  @media (max-width: 720px) {
    .nav-links {
      display: none;
    }
  }
</style>
