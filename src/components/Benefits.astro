---
import { benefits } from "../data/landing";
const titles = ["Dome · Library", "Dome · Many", "Dome · Studio", "Dome · Settings"];
---

<section class="bn section" id="benefits">
  <div class="wrap">
    <div class="bn-head" data-reveal>
      <p class="eyebrow">— Why Dome</p>
      <h2 class="h-display bn-h2">See it work, not just read about it.</h2>
      <p class="bn-sub">
        One calm workspace where your sources, your AI agent, and your study tools live together.
      </p>
    </div>

    <div class="bn-slider" data-bn-slider data-reveal>
      <!-- Left: benefit copy + controls -->
      <div class="bn-left">
        <div class="bn-panes">
          {benefits.map((b, i) => (
            <div class="bn-pane" data-pane={i} data-active={i === 0 ? "" : undefined}>
              <div class="bn-icon" style={`background:${b.accent}`}>
                <img src={b.img} alt="" width="48" height="48" loading="lazy" />
              </div>
              <h3 class="bn-t">{b.title}</h3>
              <p class="bn-p">{b.text}</p>
            </div>
          ))}
        </div>
        <div class="bn-nav">
          <button type="button" class="bn-arrow" data-bn-prev aria-label="Previous">←</button>
          <div class="bn-dots" role="tablist">
            {benefits.map((b, i) => (
              <button
                type="button"
                class="bn-dot"
                data-bn-dot={i}
                data-active={i === 0 ? "" : undefined}
                aria-label={b.title}
              ></button>
            ))}
          </div>
          <button type="button" class="bn-arrow" data-bn-next aria-label="Next">→</button>
        </div>
      </div>

      <!-- Right: app simulation -->
      <div class="bn-right">
        <div class="appwin bn-win">
          <div class="appwin-bar">
            <span class="appwin-dot" style="background:#e5756a"></span>
            <span class="appwin-dot" style="background:#ebb447"></span>
            <span class="appwin-dot" style="background:#6ac47f"></span>
            <span class="appwin-title" data-bn-title>{titles[0]}</span>
          </div>
          <div class="bn-screens">
            {/* 0 — Library */}
            <div class="bn-screen" data-screen={0} data-active>
              <p class="bn-scr-ey">All your sources · one place</p>
              <ul class="bn-list">
                <li><span>📝</span> Lecture notes — Week 1–6 <em>Biology</em></li>
                <li><span>📄</span> Smith et al. (2024).pdf <em>Thesis</em></li>
                <li><span>▶</span> Krebs cycle — video <em>Biology</em></li>
                <li><span>🔗</span> arxiv.org/abs/2406… <em>Reading</em></li>
              </ul>
            </div>
            {/* 1 — Ask Many */}
            <div class="bn-screen" data-screen={1}>
              <div class="bn-chat">
                <div class="bn-cmsg bn-cu"><div class="bn-cb">Summarise chapter 4 and cite it.</div></div>
                <div class="bn-cmsg bn-ca">
                  <div class="bn-cb">Three claims, each grounded — habits are context-bound
                    <span class="bn-cite">p.87</span>, projects fail at handoffs
                    <span class="bn-cite">p.91</span>.</div>
                </div>
              </div>
            </div>
            {/* 2 — Studio */}
            <div class="bn-screen" data-screen={2}>
              <p class="bn-scr-ey">Studio · generated from your sources</p>
              <div class="bn-studio">
                <span class="bn-tag">🧠 Mindmap</span>
                <span class="bn-tag">❓ Quiz · 12</span>
                <span class="bn-tag">🃏 Flashcards · FSRS</span>
                <span class="bn-tag">📑 Study guide</span>
                <span class="bn-tag">🗓 Timeline</span>
              </div>
            </div>
            {/* 3 — Privacy */}
            <div class="bn-screen" data-screen={3}>
              <p class="bn-scr-ey">Settings · privacy</p>
              <ul class="bn-settings">
                <li>Run locally with Ollama <span class="bn-toggle is-on">on</span></li>
                <li>Cloud providers (optional) <span class="bn-toggle">off</span></li>
                <li class="bn-path">Library: <code>~/Dome</code> · stays on this device 🔒</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const TITLES = ["Dome · Library", "Dome · Many", "Dome · Studio", "Dome · Settings"];
  document.querySelectorAll<HTMLElement>("[data-bn-slider]").forEach((root) => {
    const panes = Array.from(root.querySelectorAll<HTMLElement>(".bn-pane"));
    const screens = Array.from(root.querySelectorAll<HTMLElement>(".bn-screen"));
    const dots = Array.from(root.querySelectorAll<HTMLElement>("[data-bn-dot]"));
    const title = root.querySelector<HTMLElement>("[data-bn-title]");
    const n = panes.length;
    if (!n) return;
    let i = 0;
    let timer = 0;

    const set = (k: number) => {
      i = (k + n) % n;
      panes.forEach((p, idx) => p.toggleAttribute("data-active", idx === i));
      screens.forEach((p, idx) => p.toggleAttribute("data-active", idx === i));
      dots.forEach((p, idx) => p.toggleAttribute("data-active", idx === i));
      if (title) title.textContent = TITLES[i] ?? TITLES[0];
    };
    const restart = () => {
      window.clearInterval(timer);
      if (!reduce) timer = window.setInterval(() => set(i + 1), 4000);
    };
    root.querySelector("[data-bn-prev]")?.addEventListener("click", () => { set(i - 1); restart(); });
    root.querySelector("[data-bn-next]")?.addEventListener("click", () => { set(i + 1); restart(); });
    dots.forEach((d, idx) => d.addEventListener("click", () => { set(idx); restart(); }));

    set(0);
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => (e.isIntersecting ? restart() : window.clearInterval(timer))),
      { threshold: 0.3 },
    );
    io.observe(root);
  });
</script>

<style>
  .bn {
    background: var(--color-bg);
  }
  .bn-head {
    max-width: 36rem;
    margin-bottom: 2.4rem;
  }
  .bn-h2 {
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    margin: 0.6rem 0 0.6rem;
  }
  .bn-sub {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }
  .bn-slider {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 2.4rem;
    align-items: center;
  }

  /* Left copy */
  .bn-panes {
    position: relative;
    min-height: 14rem;
  }
  .bn-pane {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
  }
  .bn-pane[data-active] {
    opacity: 1;
    visibility: visible;
    transform: none;
    position: relative;
  }
  .bn-icon {
    width: 72px;
    height: 72px;
    border-radius: 16px;
    display: grid;
    place-items: center;
    margin-bottom: 1rem;
  }
  .bn-icon img {
    width: 48px;
    height: 48px;
    object-fit: contain;
  }
  .bn-t {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.6rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 0.5rem;
    color: var(--color-text);
  }
  .bn-p {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 26rem;
  }
  .bn-nav {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.6rem;
  }
  .bn-arrow {
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
    font-size: 1rem;
    transition: background 0.15s ease;
  }
  .bn-arrow:hover {
    background: var(--c-mint);
  }
  .bn-dots {
    display: flex;
    gap: 0.5rem;
  }
  .bn-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    border: none;
    background: var(--color-border);
    cursor: pointer;
    padding: 0;
    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }
  .bn-dot[data-active] {
    background: var(--color-accent);
    transform: scale(1.3);
  }

  /* Right app window */
  .bn-screens {
    position: relative;
    height: 300px;
    background: var(--color-surface);
  }
  .bn-screen {
    position: absolute;
    inset: 0;
    padding: 1.1rem 1.2rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
  }
  .bn-screen[data-active] {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .bn-scr-ey {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--color-ink-3);
    margin: 0 0 0.8rem;
  }
  .bn-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .bn-list li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 0.55rem 0.7rem;
  }
  .bn-list li em {
    margin-left: auto;
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 9px;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .bn-chat {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .bn-cmsg {
    max-width: 90%;
  }
  .bn-cu {
    align-self: flex-end;
  }
  .bn-ca {
    align-self: flex-start;
  }
  .bn-cb {
    font-size: 0.88rem;
    line-height: 1.45;
    padding: 0.55rem 0.8rem;
    border-radius: 12px;
  }
  .bn-cu .bn-cb {
    background: var(--color-accent);
    color: #fff;
    border-bottom-right-radius: 3px;
  }
  .bn-ca .bn-cb {
    background: var(--color-paper-deep);
    color: var(--color-text);
    border-bottom-left-radius: 3px;
  }
  .bn-cite {
    font-family: var(--font-mono);
    font-size: 10px;
    background: var(--c-mint);
    padding: 0 4px;
    border-radius: 2px;
    color: var(--color-sage-dark);
  }
  .bn-studio {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .bn-tag {
    font-size: 0.85rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.4rem 0.85rem;
    color: var(--color-text);
  }
  .bn-settings {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .bn-settings li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.92rem;
    color: var(--color-text);
    border-bottom: 1px dashed var(--color-border);
    padding-bottom: 0.7rem;
  }
  .bn-toggle {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--color-paper-deep);
    color: var(--color-ink-3);
  }
  .bn-toggle.is-on {
    background: var(--color-accent);
    color: #fff;
  }
  .bn-path {
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    border-bottom: none;
  }
  .bn-path code {
    font-family: var(--font-mono);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 0 5px;
    font-size: 0.85em;
  }

  @media (max-width: 880px) {
    .bn-slider {
      grid-template-columns: 1fr;
      gap: 1.6rem;
    }
    .bn-panes {
      min-height: 12rem;
    }
  }
</style>
