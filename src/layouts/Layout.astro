---
import type { Locale } from "../i18n";
import { localeFromPath, localizePath, t } from "../i18n";
import NoisyGradient from "../components/NoisyGradient.astro";
import { softwareJsonLd, webSiteJsonLd } from "../lib/seo";
import { DEFAULT_OG_IMAGE, absoluteUrl, siteOrigin } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  canonicalPath?: string;
  hreflangEs?: string;
  hreflangEn?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  robots?: string;
  publishedTime?: string;
  modifiedTime?: string;
  jsonLd?: unknown;
  rssPath?: string;
  editorial?: boolean;
}

const pathLocale = localeFromPath(Astro.url.pathname);
const locale: Locale = Astro.props.locale ?? pathLocale;
const copy = t(locale);

const {
  title = copy.seo.title,
  description = copy.seo.description,
  canonicalPath: canonicalPathProp,
  hreflangEs,
  hreflangEn,
  ogImage = DEFAULT_OG_IMAGE,
  ogType = "website",
  robots = "index, follow",
  publishedTime,
  modifiedTime,
  jsonLd,
  rssPath,
  editorial = false,
} = Astro.props;

const siteUrl = siteOrigin(Astro.site);
const barePath = canonicalPathProp ?? (Astro.url.pathname.replace(/\/+$/, "") || "/");
const esPath = hreflangEs ?? localizePath(barePath === "/" ? "/" : barePath.replace(/^\/en/, "") || "/", "es");
const enPath = hreflangEn ?? localizePath(barePath === "/" ? "/" : barePath.replace(/^\/en/, "") || "/", "en");
const canonicalUrl = `${siteUrl}${locale === "en" ? enPath : esPath === "/" ? "/" : esPath}`;
const esUrl = `${siteUrl}${esPath === "/" ? "/" : esPath}`;
const enUrl = `${siteUrl}${enPath}`;
const ogLocale = locale === "es" ? "es_ES" : "en_US";
const altOg = locale === "es" ? "en_US" : "es_ES";
const ogImageUrl = absoluteUrl(ogImage, siteUrl);
const isHome = (barePath.replace(/\/+$/, "") || "/") === "/";
const structured =
  jsonLd ??
  (isHome ? [softwareJsonLd(siteUrl, description), webSiteJsonLd(siteUrl)] : undefined);
const rssHref = rssPath ? `${siteUrl}${rssPath}` : `${siteUrl}${localizePath("/rss.xml", locale)}`;

const moonColors = [
  { color: "rgba(224,234,180,0.48)", stop: "0%" },
  { color: "rgba(89,96,55,0.5)", stop: "28%" },
  { color: "rgba(207,209,235,0.1)", stop: "52%" },
  { color: "rgba(24,24,27,0)", stop: "78%" },
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#18181B" />
    <meta name="mobile-web-app-capable" content="yes" />
    <link rel="icon" type="image/png" href="/assets/many.png" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Alder Velasquez" />
    <meta name="robots" content={robots} />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={altOg} />
    <meta property="og:site_name" content="Dome" />
    {publishedTime ? <meta property="article:published_time" content={publishedTime} /> : null}
    {modifiedTime ? <meta property="article:modified_time" content={modifiedTime} /> : null}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="alternate" type="application/rss+xml" title={`${copy.nav.blog} — Dome`} href={rssHref} />

    {
      structured ? (
        <script type="application/ld+json" set:html={JSON.stringify(structured)} />
      ) : null
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        var want = "es";
        var stored = null;
        try {
          stored = localStorage.getItem("dome-locale");
          if (stored === "en" || stored === "es") want = stored;
          else stored = null;
        } catch (e) {
          stored = null;
        }
        if (!stored) {
          var langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language];
          for (var i = 0; i < langs.length; i++) {
            var tag = String(langs[i] || "").toLowerCase();
            if (tag.indexOf("en") === 0) {
              want = "en";
              break;
            }
            if (tag.indexOf("es") === 0) {
              want = "es";
              break;
            }
          }
        }
        var path = location.pathname;
        var onEn = path === "/en" || path.indexOf("/en/") === 0;
        if (want === "en" && !onEn) {
          var dest = path === "/" ? "/en/" : "/en" + path;
          location.replace(dest + location.search + location.hash);
        } else if (want === "es" && onEn) {
          var rest = path === "/en" || path === "/en/" ? "/" : path.replace(/^\/en/, "") || "/";
          location.replace(rest + location.search + location.hash);
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{copy.nav.skip}</a>
    {
      editorial ? null : (
        <>
          <div class="body-moon body-moon-top" aria-hidden="true">
            <NoisyGradient origin="top-middle" size="180% 95%" colors={moonColors} />
          </div>
          <div class="body-moon body-moon-bot" aria-hidden="true">
            <NoisyGradient origin="bottom-middle" size="180% 95%" colors={moonColors} />
          </div>
        </>
      )
    }
    <div class="page-content">
      <slot />
    </div>
    <script>
      import "../scripts/landing-gsap.ts";
      import "../scripts/how-carousel.ts";
      import "../scripts/noisy-gradient.ts";
    </script>
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #18181b;
    --color-surface: #27272a;
    --color-text: #fafafa;
    --color-text-secondary: #a1a1aa;
    --color-accent: #fafafa;
    --color-accent-hover: #e4e4e7;
    --color-border: rgba(255, 255, 255, 0.1);
    --color-problem: #bd3f32;
    --color-ink-3: #a1a1aa;
    --color-many-body: #e0eab4;
    --color-many-stroke: #596037;
    --c-lime: #dde9b2;
    --c-mint: #eef5e0;
    --c-lavender: #cfd1eb;
    --c-olive: #e0eab4;
    --color-white: #fff;
    --color-black: #000;
    --color-zinc-50: #f4f4f5;
    --color-zinc-75: #f4f4f4;
    --color-zinc-100: #d4d4d8;
    --color-zinc-300: #71717a;
    --color-zinc-400: #52525b;
    --color-zinc-500: #3f3f46;
    --color-zinc-550: #3f4270;
    --color-zinc-600: #2a2a2e;
    --color-zinc-700: #222226;
    --color-zinc-750: #1c1c20;
    --color-zinc-800: #1a1a1e;
    --color-zinc-850: #141416;
    --color-zinc-875: #121214;
    --color-zinc-950: #09090b;
    --color-olive-bright: #7f9463;
    --color-olive-fill: #a3b56a;
    --color-olive-ink: #3f4a22;
    --color-olive-muted: #2a2e22;
    --color-olive-chip: #2a3120;
    --color-olive-wash: #d5e3b6;
    --color-olive-icon: #d7ddc4;
    --color-lavender-line: #9aa0c8;
    --color-lavender-soft: #b7bcd8;
    --color-lavender-chip: #3a3c4d;
    --color-lavender-wash: #ececf6;
    --color-lavender-mid: #8b8eb8;
    --color-muted-strong: #8b8b93;
    --color-muted-soft: #8f8f97;
    --color-muted-tag: #9a9aa3;
    --color-wait-text: #eceef8;
    --color-scene-border: #ececec;
    --color-amber: #f6e7c1;
    --color-amber-ink: #6a4e16;

    --hero-bg: #18181b;
    --hero-surface: #27272a;
    --hero-text: #fafafa;
    --hero-muted: #a1a1aa;
    --hero-border: rgba(255, 255, 255, 0.1);

    --bg-primary: var(--color-surface);
    --bg-secondary: var(--color-bg);
    --text-primary: var(--color-text);
    --text-secondary: var(--color-text-secondary);
    --text-muted: var(--color-ink-3);
    --border: var(--color-border);

    --font-sans: "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
    --font-display: var(--font-sans);
    --font-mono: "JetBrains Mono", ui-monospace, monospace;

    --section-padding: clamp(4rem, 10vw, 8rem);
    --container-width: min(1400px, 90vw);
    --shadow-sm: none;
    --shadow-md: none;
    --transition-fast: 150ms ease;
    --transition-base: 250ms ease;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    overflow-x: hidden;
    -webkit-text-size-adjust: 100%;
    background: #18181b;
  }

  body {
    position: relative;
    font-family: var(--font-sans);
    background: #18181b;
    color: var(--color-text);
    line-height: 1.6;
    overflow-x: visible;
    -webkit-font-smoothing: antialiased;
    min-width: 0;
    padding-left: env(safe-area-inset-left);
    padding-right: env(safe-area-inset-right);
  }

  .body-moon {
    position: absolute;
    left: 0;
    right: 0;
    pointer-events: none;
    z-index: 0;
  }
  .body-moon-top {
    top: 0;
    height: min(68vh, 44rem);
  }
  .body-moon-bot {
    bottom: 0;
    height: min(58vh, 38rem);
  }

  .page-content {
    position: relative;
    z-index: 2;
  }

  .hero,
  .ft {
    background-color: transparent;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .skip-link {
    position: absolute;
    left: 1rem;
    top: 0.85rem;
    z-index: 200;
    transform: translateY(-150%);
    padding: 0.7rem 1.1rem;
    border-radius: 999px;
    background: var(--color-text);
    color: var(--color-bg);
    font-weight: 650;
    font-size: 0.9rem;
  }
  .skip-link:focus,
  .skip-link:focus-visible {
    transform: none;
  }
  :focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 3px;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  .wrap {
    width: min(1120px, 92vw);
    margin-inline: auto;
  }
  .wrap-wide {
    width: min(1200px, 94vw);
    margin-inline: auto;
  }
  .section {
    padding: clamp(3.5rem, 7vw, 6rem) 0;
  }
  #como-funciona,
  #ediciones,
  #confianza,
  #faq,
  #download,
  #demo {
    scroll-margin-top: 5.75rem;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-ink-3);
    margin: 0;
  }
  .h-display {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.04;
    color: var(--color-text);
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.85rem 1.5rem;
    border-radius: 999px;
    text-decoration: none;
    cursor: pointer;
    border: 1.5px solid transparent;
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      color 0.2s ease,
      opacity 0.2s ease;
  }
  .btn-primary {
    background: #fafafa;
    color: #18181b;
  }
  .btn-primary:hover {
    background: #e4e4e7;
  }
  .btn-ghost {
    background: transparent;
    color: #fafafa;
    border-color: rgba(255, 255, 255, 0.28);
  }
  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.06);
  }
  .btn-text {
    background: transparent;
    border: none;
    color: #fafafa;
    padding: 0.85rem 0.4rem;
    font-weight: 500;
    text-underline-offset: 3px;
  }
  .btn-text:hover {
    text-decoration: underline;
  }
  .btn-on-dark {
    background: #fafafa;
    color: #18181b;
  }
  .btn-on-dark:hover {
    background: #e4e4e7;
  }
  .btn-ghost-on-dark {
    background: transparent;
    color: #fafafa;
    border-color: rgba(255, 255, 255, 0.28);
  }
  .btn-ghost-on-dark:hover {
    background: rgba(255, 255, 255, 0.06);
  }

  .appwin {
    background: var(--hero-surface);
    border: 1px solid var(--hero-border);
    border-radius: 14px;
    overflow: hidden;
  }
  .appwin-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 9px 12px;
    background: #18181b;
    border-bottom: 1px solid var(--hero-border);
  }
  .appwin-dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    flex: none;
  }
  .appwin-title {
    margin-left: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--hero-muted);
  }
</style>
