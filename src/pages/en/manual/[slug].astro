---
import Layout from "../../../layouts/Layout.astro";
import ContentArticle from "../../../components/content/ContentArticle.astro";
import { publishedEntries, staticPathsFor } from "../../../lib/content";
import { breadcrumbJsonLd, techArticleJsonLd } from "../../../lib/seo";
import { siteOrigin } from "../../../lib/site";
import { localizePath, t } from "../../../i18n";
import type { ContentEntry } from "../../../lib/content";
import type { Locale } from "../../../i18n";

export async function getStaticPaths() {
  return staticPathsFor("manual", "en");
}

interface Props {
  entry: ContentEntry;
  locale: Locale;
  translationPath: string | null;
}

const { entry, locale, translationPath } = Astro.props;
const siblings = await publishedEntries("manual", locale);
const origin = siteOrigin(Astro.site);
const path = localizePath(`/manual/${entry.data.permalink}`, locale);
const url = `${origin}${path}`;
const copy = t(locale);
const image = entry.data.ogImage || entry.data.heroImage || "/social.png";
const howTo = "howTo" in entry.data ? entry.data.howTo : undefined;
---

<Layout
  locale={locale}
  editorial
  title={`${entry.data.title} — Dome`}
  description={entry.data.description}
  canonicalPath={path}
  hreflangEs={translationPath ?? localizePath(path.replace(/^\/en/, "") || "/", "es")}
  hreflangEn={path}
  ogImage={image}
  ogType="article"
  publishedTime={entry.data.publishedAt.toISOString()}
  modifiedTime={(entry.data.updatedAt ?? entry.data.publishedAt).toISOString()}
  jsonLd={[
    techArticleJsonLd({
      origin,
      url,
      title: entry.data.title,
      description: entry.data.description,
      image,
      locale,
      publishedAt: entry.data.publishedAt,
      updatedAt: entry.data.updatedAt,
      steps: howTo,
    }),
    breadcrumbJsonLd(origin, [
      { name: "Dome", path: "/en/" },
      { name: copy.nav.manuals, path: "/en/manual" },
      { name: entry.data.title, path },
    ]),
  ]}
>
  <ContentArticle
    locale={locale}
    kind="manual"
    entry={entry}
    siblings={siblings}
    translationPath={translationPath}
  />
</Layout>
