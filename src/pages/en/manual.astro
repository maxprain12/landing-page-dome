---
import Layout from "../../layouts/Layout.astro";
import MarketingShell from "../../components/MarketingShell.astro";
import { links } from "../../data/landing";
import { t } from "../../i18n";

const locale = "en" as const;
const page = t(locale).pages.manual;
---

<Layout locale={locale} title={page.title} description={page.description} canonicalPath="/manual">
  <MarketingShell locale={locale} page={page} secondaryHref={links.github} />
</Layout>
