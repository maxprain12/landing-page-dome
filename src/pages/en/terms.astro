---
import Layout from "../../layouts/Layout.astro";
import LegalShell from "../../components/LegalShell.astro";
import TermsBody from "../../components/TermsBody.astro";
import Footer from "../../components/Footer.astro";
import { t } from "../../i18n";

const locale = "en" as const;
const legal = t(locale).legal;
---

<Layout locale={locale} title={`${legal.termsTitle} — Dome`} description={legal.termsDescription} canonicalPath="/terms">
  <LegalShell locale={locale} title={legal.termsTitle} eyebrow={legal.termsEyebrow} lastUpdated="2026-09-05">
    <TermsBody locale={locale} />
  </LegalShell>
  <Footer locale={locale} />
</Layout>
