---
import Layout from "../../layouts/Layout.astro";
import ContentArticle from "../../components/content/ContentArticle.astro";
import { contentCover, publishedEntries, staticPathsFor } from "../../lib/content";
import { breadcrumbJsonLd, techArticleJsonLd } from "../../lib/seo";
import { siteOrigin } from "../../lib/site";
import { localizePath, t } from "../../i18n";
import type { ContentEntry } from "../../lib/content";
import type { Locale } from "../../i18n";

export async function getStaticPaths() {
  return staticPathsFor("manual", "es");
}

interface Props {
  entry: ContentEntry;
  locale: Locale;
  translationPath: string | null;
}

const { entry, locale, translationPath } = Astro.props;
const siblings = await publishedEntries("manual", locale);
const origin = siteOrigin(Astro.site);
const path = localizePath(`/manual/${entry.data.slug}`, locale);
const url = `${origin}${path}`;
const copy = t(locale);
const image = contentCover(entry);
---

<Layout
  locale={locale}
  editorial
  title={`${entry.data.title} — Dome`}
  description={entry.data.description}
  canonicalPath={path}
  hreflangEs={path}
  hreflangEn={translationPath ?? localizePath(path, "en")}
  ogImage={image}
  ogType="article"
  publishedTime={entry.data.date.toISOString()}
  modifiedTime={entry.data.date.toISOString()}
  jsonLd={[
    techArticleJsonLd({
      origin,
      url,
      title: entry.data.title,
      description: entry.data.description,
      image,
      locale,
      publishedAt: entry.data.date,
    }),
    breadcrumbJsonLd(origin, [
      { name: "Dome", path: "/" },
      { name: copy.nav.manuals, path: "/manual" },
      { name: entry.data.title, path },
    ]),
  ]}
>
  <ContentArticle
    locale={locale}
    kind="manual"
    entry={entry}
    siblings={siblings}
    translationPath={translationPath}
  />
</Layout>
