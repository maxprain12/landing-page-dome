---
import Layout from "../layouts/Layout.astro";
import ContactView from "../components/ContactView.astro";
import { links } from "../data/landing";
import { contactJsonLd } from "../lib/seo";
import { siteOrigin } from "../lib/site";
import { t } from "../i18n";

const locale = "es" as const;
const page = t(locale).pages.contact;
const origin = siteOrigin(Astro.site);
---

<Layout
  locale={locale}
  title={page.title}
  description={page.description}
  canonicalPath="/contact"
  jsonLd={contactJsonLd(origin, `${origin}/contact`, links.email, page.description)}
>
  <ContactView locale={locale} />
</Layout>
